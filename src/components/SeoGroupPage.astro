---
import Layout from '../layouts/Layout.astro';
import { teams as allTeams, generateMatches } from '../data/worldCupData';

interface Props {
  letter: string;
  title: string;
  description: string;
  h1: string;
  teams: Array<{ id: string; name: string; code: string; group: string; players: string[] }>;
  jsonLd: Record<string, any>;
}

const { letter, title, description, h1, teams: groupTeams, jsonLd } = Astro.props;

const allMatches = generateMatches();
const groupMatches = allMatches.filter(m => m.group === letter);
---

<Layout title={title} description={description}>
  <main class="container seo-group-page">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <header>
      <div class="logo-badge">FIFA World Cup 2026</div>
      <h1>{h1}</h1>
      <p class="subtitle">Conheça as seleções, os jogos e simule os resultados do Grupo {letter}!</p>
    </header>

    <section class="glass-card seo-section">
      <h2>🏴 Seleções do Grupo {letter}</h2>
      <div class="seo-teams-grid">
        {groupTeams.map(team => (
          <div class="seo-team-card glass-card">
            <img
              src={`https://flagcdn.com/64x48/${team.code}.png`}
              alt={`Bandeira ${team.name}`}
              width="64"
              height="48"
              loading="lazy"
            />
            <h3>{team.name}</h3>
            <p class="text-muted seo-players-label">Destaques:</p>
            <ul class="seo-players-list">
              {team.players.map(p => <li>{p}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="glass-card seo-section">
      <h2>📅 Jogos do Grupo {letter}</h2>
      <table class="standing-table seo-matches-table">
        <thead>
          <tr>
            <th>Rodada</th>
            <th class="align-left">Mandante</th>
            <th>vs</th>
            <th class="align-left">Visitante</th>
            <th>Data / Horário</th>
          </tr>
        </thead>
        <tbody>
          {groupMatches.map(m => {
            const home = allTeams[m.homeId];
            const away = allTeams[m.awayId];
            return (
              <tr>
                <td style="text-align:center; font-weight:700; color:var(--color-accent);">
                  {m.round}ª
                </td>
                <td class="align-left">
                  <img src={`https://flagcdn.com/20x15/${home.code}.png`} alt="" width="20" height="15" style="vertical-align:middle; margin-right:0.4rem;" loading="lazy" />
                  {home.name}
                </td>
                <td style="text-align:center; color:var(--text-muted);">×</td>
                <td class="align-left">
                  <img src={`https://flagcdn.com/20x15/${away.code}.png`} alt="" width="20" height="15" style="vertical-align:middle; margin-right:0.4rem;" loading="lazy" />
                  {away.name}
                </td>
                <td style="text-align:center; font-size:0.8rem; color:var(--color-accent); font-weight:600;">
                  <div>{m.datetime}</div>
                  <div style="font-size:0.7rem; color:var(--text-muted); font-weight:normal; margin-top:0.2rem;">
                    🏟️ {m.stadium}, {m.city}
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </section>

    <section class="glass-card seo-section seo-cta-section">
      <h2>🏆 Simule os Resultados!</h2>
      <p>Monte seus palpites para o Grupo {letter} e todos os outros grupos, defina o mata-mata e descubra quem será campeão!</p>
      <a href="/" class="btn btn-primary seo-cta-btn">CRIAR MINHA SIMULAÇÃO →</a>
    </section>
  </main>

  <style>
    .seo-group-page { padding-bottom: 5rem; }
    .seo-section { padding: 1.5rem; margin-bottom: 1.5rem; }
    .seo-section h2 {
      color: var(--color-secondary);
      font-size: 1.2rem;
      font-weight: 800;
      margin-bottom: 1rem;
    }
    .seo-teams-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1rem;
    }
    .seo-team-card {
      padding: 1.25rem;
      text-align: center;
      border: 1px solid rgba(255,255,255,0.06);
    }
    .seo-team-card img { margin: 0 auto 0.75rem; display: block; border-radius: 4px; }
    .seo-team-card h3 { font-size: 1.05rem; margin-bottom: 0.5rem; }
    .seo-players-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.25rem; }
    .seo-players-list {
      list-style: none;
      padding: 0;
      margin: 0;
      font-size: 0.85rem;
      color: var(--text-main);
    }
    .seo-players-list li { padding: 0.15rem 0; }
    .seo-matches-table { margin-bottom: 0; }
    .seo-matches-table td, .seo-matches-table th { padding: 0.7rem 0.5rem; }
    .seo-cta-section { text-align: center; }
    .seo-cta-section p { max-width: 520px; margin: 0 auto 1.25rem; color: var(--text-muted); }
    .seo-cta-btn { max-width: 320px; text-decoration: none; display: inline-block; }
    @media (max-width: 640px) {
      .seo-teams-grid { grid-template-columns: repeat(2, 1fr); }
      .seo-section { padding: 1.1rem; }
    }
  </style>
</Layout>
