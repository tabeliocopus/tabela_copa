---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const { slug } = Astro.params;

const supabaseUrl = (import.meta.env.PUBLIC_SUPABASE_URL || '').replace(/\/rest\/v1\/?$/, '').replace(/\/$/, '');
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';

let prediction = null;
let lead = null;
let errorMsg = '';

if (supabaseUrl && supabaseAnonKey) {
  try {
    const res = await fetch(
      `${supabaseUrl}/rest/v1/shared_predictions?slug=eq.${slug}&select=*,leads(nome)&limit=1`,
      { headers: { apikey: supabaseAnonKey, Authorization: `Bearer ${supabaseAnonKey}` } }
    );
    const data = await res.json();
    if (data && data.length > 0) {
      prediction = data[0];
      lead = data[0].leads;
    } else {
      errorMsg = 'Simulação não encontrada.';
    }
  } catch (e) {
    errorMsg = 'Erro ao carregar simulação.';
  }
} else {
  errorMsg = 'Serviço temporariamente indisponível.';
}

const sim = prediction?.simulation_data || {};
const champion = sim.champion || null;
const runnerUp = sim.runnerUp || null;
const topScorers = sim.topScorers || [];
const createdAt = prediction?.created_at
  ? new Date(prediction.created_at).toLocaleDateString('pt-BR', { day:'2-digit', month:'long', year:'numeric' })
  : '';

const pageTitle = champion
  ? `Palpite de ${lead?.nome || 'um fã'}: ${champion} Campeão da Copa 2026!`
  : 'Palpite da Copa do Mundo 2026';

const pageDesc = champion
  ? `${lead?.nome || 'Um usuário'} simulou a Copa 2026 e escolheu ${champion} como Campeão Mundial! Veja os artilheiros, o mata-mata e crie o seu próprio palpite.`
  : 'Veja esta simulação da Copa do Mundo FIFA 2026 e crie a sua própria!';

const ogImageUrl = new URL(`/api/og/${slug}`, Astro.url).href;
---

<Layout title={pageTitle} description={pageDesc} image={ogImageUrl}>
  <main class="container palpite-page">

    {errorMsg ? (
      <div class="palpite-error glass-card">
        <div style="font-size:3rem;">😕</div>
        <h1>Simulação não encontrada</h1>
        <p class="text-muted">{errorMsg}</p>
        <a href="/" class="btn btn-primary" style="max-width:280px; margin-top:1rem; display:block; text-align:center; text-decoration:none;">
          Criar Minha Simulação ➜
        </a>
      </div>
    ) : (
      <>
        <!-- HERO -->
        <div class="palpite-hero">
          <div class="logo-badge">Copa do Mundo 2026</div>
          <h1 class="palpite-title">
            Palpite de <span class="palpite-author">{lead?.nome || 'um fã'}</span>
          </h1>
          <p class="palpite-date text-muted">Criado em {createdAt}</p>
        </div>

        <!-- CHAMPION CARD -->
        {champion && (
          <div class="palpite-champion glass-card">
            <div class="palpite-champion-label">👑 Campeão Escolhido</div>
            <div class="palpite-champion-name">{champion}</div>
            {runnerUp && (
              <div class="palpite-runnerup text-muted">🥈 Vice-campeão: <strong style="color:var(--text-main)">{runnerUp}</strong></div>
            )}
          </div>
        )}

        <!-- TOP SCORERS -->
        {topScorers.length > 0 && (
          <div class="palpite-section glass-card">
            <h2 class="palpite-section-title">👟 Top Artilheiros da Simulação</h2>
            <table class="standing-table" style="font-size:1rem;">
              <thead>
                <tr>
                  <th style="text-align:center; width:40px;">#</th>
                  <th class="align-left">Jogador</th>
                  <th class="align-left">Seleção</th>
                  <th>Gols</th>
                </tr>
              </thead>
              <tbody>
                {topScorers.slice(0, 5).map((s: any, i: number) => (
                  <tr>
                    <td style="text-align:center; font-weight:800; font-size:1.1rem;">
                      {i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : `${i + 1}º`}
                    </td>
                    <td class="align-left" style="font-weight:600;">{s.player}</td>
                    <td class="align-left" style="color:var(--text-muted);">{s.team}</td>
                    <td style="text-align:center; font-weight:700; color:var(--color-primary);">{s.goals}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        <!-- BRACKET SUMMARY -->
        {sim.bracketSummary && sim.bracketSummary.length > 0 && (
          <div class="palpite-section glass-card">
            <h2 class="palpite-section-title">🏆 Fases do Mata-Mata</h2>
            <div class="palpite-bracket-summary">
              {sim.bracketSummary.map((round: any) => (
                <div class="palpite-round">
                  <div class="palpite-round-title">{round.name}</div>
                  <div class="palpite-round-teams">
                    {round.teams.map((t: string) => (
                      <span class="palpite-team-chip">{t}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- CTA -->
        <div class="palpite-cta glass-card">
          <div class="palpite-cta-icon">⚽</div>
          <h2>Você discorda? Crie o seu palpite!</h2>
          <p class="text-muted">Simule todos os 72 jogos da fase de grupos, defina os artilheiros e monte seu chaveamento do mata-mata até a grande final da Copa 2026.</p>
          <a href="/" class="btn btn-primary" style="max-width:320px; margin:1rem auto 0; display:block; text-align:center; text-decoration:none; padding:1rem;">
            🏆 Criar Minha Simulação Agora ➜
          </a>
        </div>

        <!-- SHARE ROW -->
        <div class="palpite-share-row">
          <button id="copy-palpite-btn" class="palpite-share-btn">
            📋 Copiar link deste palpite
          </button>
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`Veja o palpite de ${lead?.nome || 'um fã'} para a Copa 2026! ${champion ? champion + ' Campeão! ' : ''}${Astro.url.href}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="palpite-share-btn whatsapp"
          >
            📱 Compartilhar no WhatsApp
          </a>
        </div>
      </>
    )}

  </main>

  <script define:vars={{ pageUrl: Astro.url.href }}>
    const copyBtn = document.getElementById('copy-palpite-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(pageUrl).then(() => {
          copyBtn.textContent = '✅ Link copiado!';
          setTimeout(() => { copyBtn.textContent = '📋 Copiar link deste palpite'; }, 2500);
        });
      });
    }
  </script>

  <style>
    .palpite-page {
      max-width: 800px;
      padding-top: 3rem;
      padding-bottom: 6rem;
    }

    .palpite-hero {
      text-align: center;
      margin-bottom: 2rem;
    }

    .palpite-title {
      font-size: 2rem;
      font-weight: 800;
      margin: 0.5rem 0 0.25rem;
      background: linear-gradient(to right, #ffffff, #e2e8f0);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .palpite-author {
      background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .palpite-date {
      font-size: 0.9rem;
    }

    .palpite-champion {
      padding: 2.5rem;
      text-align: center;
      margin-bottom: 1.5rem;
      background: linear-gradient(135deg, rgba(255,215,0,0.07), rgba(255,215,0,0.02));
      border: 2px solid rgba(255,215,0,0.3);
      animation: pulse-gold 2.5s infinite;
    }

    .palpite-champion-label {
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--color-accent);
      margin-bottom: 0.75rem;
    }

    .palpite-champion-name {
      font-size: 2.75rem;
      font-weight: 800;
      color: var(--color-accent);
      text-transform: uppercase;
      letter-spacing: -0.02em;
    }

    .palpite-runnerup {
      margin-top: 0.75rem;
      font-size: 1rem;
    }

    .palpite-section {
      padding: 1.75rem;
      margin-bottom: 1.5rem;
    }

    .palpite-section-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--color-secondary);
      margin-bottom: 1.25rem;
    }

    .palpite-bracket-summary {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .palpite-round {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .palpite-round-title {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-muted);
    }

    .palpite-round-teams {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .palpite-team-chip {
      background: rgba(255,255,255,0.05);
      border: 1px solid var(--border-glass);
      border-radius: 20px;
      padding: 0.25rem 0.75rem;
      font-size: 0.85rem;
      font-weight: 500;
    }

    .palpite-cta {
      padding: 2.5rem;
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .palpite-cta-icon {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }

    .palpite-cta h2 {
      font-size: 1.5rem;
      font-weight: 800;
      margin-bottom: 0.75rem;
    }

    .palpite-share-row {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 1rem;
      padding-bottom: 2rem;
    }

    .palpite-share-btn {
      padding: 0.75rem 1.5rem;
      border-radius: 30px;
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      text-decoration: none;
      border: 1px solid var(--border-glass);
      background: var(--bg-card);
      color: var(--text-main);
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .palpite-share-btn:hover {
      transform: translateY(-2px);
      border-color: rgba(255,255,255,0.2);
    }

    .palpite-share-btn.whatsapp {
      background: rgba(37, 211, 102, 0.15);
      border-color: rgba(37, 211, 102, 0.3);
      color: #25d366;
    }

    .palpite-share-btn.whatsapp:hover {
      background: rgba(37, 211, 102, 0.25);
    }

    .palpite-error {
      max-width: 480px;
      margin: 6rem auto;
      padding: 3rem 2rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .palpite-error h1 {
      font-size: 1.5rem;
      font-weight: 800;
      -webkit-text-fill-color: var(--text-main);
    }

    @keyframes pulse-gold {
      0% { box-shadow: 0 0 15px rgba(255,215,0,0.15); }
      50% { box-shadow: 0 0 35px rgba(255,215,0,0.35); }
      100% { box-shadow: 0 0 15px rgba(255,215,0,0.15); }
    }

    @media (max-width: 640px) {
      .palpite-champion-name { font-size: 2rem; }
      .palpite-title { font-size: 1.5rem; }
    }
  </style>
</Layout>
