    // BOLAO LOGIC
    // =============================================
    function generateGroupCode() {
      return 'COPA-' + Math.random().toString(36).substring(2, 6).toUpperCase();
    }
    function getSavedLead() {
      try { return JSON.parse(localStorage.getItem('lead_cadastrado')); } catch(e) { return null; }
    }
    function getSavedGroups() {
      try { return JSON.parse(localStorage.getItem('bolao_grupos')) || []; } catch(e) { return []; }
