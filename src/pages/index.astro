    function renderUserBadges(events, inviteCount) {
      const container = document.getElementById('user-badges-container');
      if (!container) return;

      const eventTypes = new Set(events.map(e => e.event_type));

      const badgesList = [
        { key: 'palpiteiro', label: 'Palpiteiro', icon: '⚽', desc: 'Fez a primeira simulação', unlocked: eventTypes.has('simulation_created') || events.length > 0, isEliteCheck: false, progress: '' },
        { key: 'criador', label: 'Fundador', icon: '👥', desc: 'Criou um grupo no Bolão', unlocked: eventTypes.has('group_created'), isEliteCheck: false, progress: '' },
        { key: 'propagador', label: 'Divulgador', icon: '📢', desc: 'Compartilhou a simulação', unlocked: eventTypes.has('simulation_shared'), isEliteCheck: false, progress: '' },
        { key: 'influenciador', label: 'Influenciador', icon: '🔥', desc: 'Convidou 5 amigos', unlocked: inviteCount >= 5, isEliteCheck: false, progress: inviteCount + '/5' },
        { key: 'embaixador', label: 'Embaixador', icon: '👑', desc: 'Convidou 10 amigos', unlocked: inviteCount >= 10, isEliteCheck: false, progress: inviteCount + '/10' },
        { key: 'elite', label: 'Elite', icon: '🏆', desc: 'Top 100 no Ranking Global', unlocked: false, isEliteCheck: true, progress: '' }
      ];

      container.innerHTML = badgesList.map(b => {
        const opacity = b.unlocked ? '1' : '0.4';
        const border = b.unlocked ? 'border: 2px solid var(--color-primary);' : 'border: 1px solid rgba(255,255,255,0.1);';
        const shadow = b.unlocked ? 'box-shadow: 0 0 10px rgba(0,255,135,0.25);' : '';
        const labelColor = b.unlocked ? 'color: var(--color-primary);' : 'color: var(--text-muted);';
        const sub = b.progress ? '<div style="font-size:0.65rem; color:var(--color-primary); font-weight:700; margin-top:0.25rem;">' + b.progress + '</div>' : '';
        const descText = b.isEliteCheck ? 'Clique para ver o Ranking' : b.desc;
        const clickStyle = b.isEliteCheck ? ' cursor:pointer;' : '';
        const clickHandler = b.isEliteCheck ? ' onclick="window.location.href=\'/ranking\'"' : '';

        return '<div class="glass-card" style="padding:0.75rem; text-align:center; border-radius:12px; ' + border + ' ' + shadow + ' opacity:' + opacity + ';' + clickStyle + '" title="' + b.desc + '"' + clickHandler + '>' +
          '<div style="font-size:1.75rem; margin-bottom:0.25rem;">' + b.icon + '</div>' +
          '<div style="font-size:0.8rem; font-weight:700; ' + labelColor + '">' + b.label + '</div>' +
          '<div style="font-size:0.65rem; color:var(--text-muted); margin-top:0.25rem; line-height:1.2;">' + descText + '</div>' +
          sub +
          '</div>';
      }).join('');
    }
    function renderMyGroups() {
      const grps = getSavedGroups();
      const list = document.getElementById('bolao-groups-list');
      if (!list) return;
      if (grps.length === 0) { list.innerHTML = '<p class="text-muted text-center" style="padding:2rem;">Voce ainda nao participa de nenhum grupo.<br/>Crie ou entre em um acima!</p>'; return; }
      list.innerHTML = grps.map((g, i) => '<div class="bolao-group-item glass-card" data-index="'+i+'"><div class="bolao-group-info"><span class="bolao-group-name">'+g.nome+'</span><span class="bolao-code-pill">'+g.codigo+'</span></div><button class="bolao-view-btn" data-index="'+i+'">Ver Ranking &rarr;</button></div>').join('');
      list.querySelectorAll('.bolao-view-btn').forEach(btn => { btn.addEventListener('click', () => { openLeaderboard(getSavedGroups()[parseInt(btn.dataset.index)]); }); });
    }
    async function openLeaderboard(group) {
      const section = document.getElementById('bolao-leaderboard-section');
      const myGroups = document.getElementById('bolao-my-groups');
      const actions = document.querySelector('.bolao-actions');
      const title = document.getElementById('bolao-leaderboard-title');
      const codeBadge = document.getElementById('bolao-leaderboard-code');
      const tbody = document.getElementById('bolao-leaderboard-body');
      if (!section || !title || !tbody) return;
      title.textContent = group.nome; codeBadge.textContent = group.codigo;
      section.style.display = 'block';
      if (myGroups) myGroups.style.display = 'none';
      if (actions) actions.style.display = 'none';
      tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted" style="padding:2rem;">Carregando...</td></tr>';
      const copyBtn = document.getElementById('bolao-copy-link-btn');
      if (copyBtn) { copyBtn.onclick = () => { const link = window.location.origin + window.location.pathname + '?bolao=' + group.codigo; navigator.clipboard.writeText(link).then(() => { copyBtn.textContent = 'Link copiado!'; setTimeout(() => { copyBtn.textContent = 'Copiar Link de Convite'; }, 2500); }); }; }
      const rawUrl = supabaseUrl || ''; const anonKey = supabaseAnonKey || '';
      let cleanUrl = rawUrl.trim().replace(/\/rest\/v1\/?$/, '').replace(/\/$/, '');
      if (!cleanUrl || !anonKey) { tbody.innerHTML = '<tr><td colspan="5" class="text-muted text-center" style="padding:1rem;">Configure o Supabase para ver participantes.</td></tr>'; return; }
      try {
        const res = await fetch(cleanUrl + '/rest/v1/grupo_membros?grupo_id=eq.' + group.id + '&select=joined_at,leads(nome,url_compartilhamento)&order=joined_at.asc', { headers: { 'apikey': anonKey, 'Authorization': 'Bearer ' + anonKey } });
        const members = await res.json();
        if (!members || members.length === 0) { tbody.innerHTML = '<tr><td colspan="5" class="text-muted text-center" style="padding:1rem;">Nenhum participante ainda. Compartilhe o codigo!</td></tr>'; return; }
        tbody.innerHTML = members.map((m, i) => { const lead = m.leads || {}; const medal = i===0?'1º':i===1?'2º':i===2?'3º':(i+1)+'º'; return '<tr><td style="text-align:center;font-weight:800;">' + medal + '</td><td class="align-left" style="font-weight:600;">' + (lead.nome||'Anônimo') + '</td><td style="text-align:center;">' + (lead.url_compartilhamento ? '<a href="' + lead.url_compartilhamento + '" target="_blank" style="color:var(--color-secondary);font-size:0.8rem;">Ver Link</a>' : '-') + '</td><td style="text-align:center;font-weight:700;color:var(--color-accent);">0 pts</td></tr>'; }).join('');
      } catch(err) { tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted" style="padding:1rem;">Erro ao carregar.</td></tr>'; console.error(err); }
    }
    const bolaoBackBtn = document.getElementById('bolao-back-btn');
    if (bolaoBackBtn) { bolaoBackBtn.addEventListener('click', () => { document.getElementById('bolao-leaderboard-section').style.display = 'none'; const mg = document.getElementById('bolao-my-groups'); const act = document.querySelector('.bolao-actions'); if (mg) mg.style.display = 'block'; if (act) act.style.display = 'grid'; }); }
    const bolaoGotoRegister = document.getElementById('bolao-goto-register');
    if (bolaoGotoRegister) { bolaoGotoRegister.addEventListener('click', () => { document.getElementById('lead-modal').classList.add('active'); }); }
    const bolaoCreateBtn2 = document.getElementById('bolao-create-btn');
    if (bolaoCreateBtn2) {
      bolaoCreateBtn2.addEventListener('click', async () => {
        const lead = getSavedLead(); if (!lead) { alert('Cadastre-se primeiro!'); return; }
        const nameInput = document.getElementById('bolao-group-name'); const groupName = nameInput.value.trim();
        if (!groupName) { alert('Digite um nome para o grupo!'); nameInput.focus(); return; }
        bolaoCreateBtn2.textContent = 'Criando...'; bolaoCreateBtn2.disabled = true;
        const codigo = generateGroupCode(); let groupId = null;
        const rawUrl = supabaseUrl || ''; const anonKey = supabaseAnonKey || '';
        let cleanUrl = rawUrl.trim().replace(/\/rest\/v1\/?$/, '').replace(/\/$/, '');
        try {
          if (cleanUrl && anonKey) {
            const lr = await fetch(cleanUrl+'/rest/v1/leads?email=eq.'+encodeURIComponent(lead.email)+'&select=id&limit=1', { headers: {'apikey':anonKey,'Authorization':'Bearer '+anonKey} });
            const ld = await lr.json(); const leadId = ld[0]&&ld[0].id;
            if (!leadId) throw new Error('Lead nao encontrado.');
            const gr = await fetch(cleanUrl+'/rest/v1/grupos', { method:'POST', headers:{'apikey':anonKey,'Authorization':'Bearer '+anonKey,'Content-Type':'application/json','Prefer':'return=representation'}, body: JSON.stringify({nome:groupName,codigo_acesso:codigo,criador_id:leadId}) });
            const gd = await gr.json(); groupId = gd[0]&&gd[0].id;
            await fetch(cleanUrl+'/rest/v1/grupo_membros', { method:'POST', headers:{'apikey':anonKey,'Authorization':'Bearer '+anonKey,'Content-Type':'application/json','Prefer':'return=minimal'}, body: JSON.stringify({grupo_id:groupId,lead_id:leadId}) });
            await recordEngagementEvent('group_created', 30, `group_created:${leadId}:${groupId || codigo}`, {
              leadId,
              groupId: groupId || codigo,
              groupName,
              codigo
            });
          }
        } catch(err) { console.error('Erro criar grupo:', err); }
        const sg = getSavedGroups(); sg.push({nome:groupName,codigo,id:groupId||codigo}); saveGroups(sg);
        nameInput.value = ''; bolaoCreateBtn2.textContent = 'Criar Grupo'; bolaoCreateBtn2.disabled = false;
        renderMyGroups(); alert('Grupo "'+groupName+'" criado!\nCodigo: '+codigo+'\n\nCompartilhe este codigo com seus amigos!');
      });
    }
    const bolaoJoinBtn2 = document.getElementById('bolao-join-btn');
    if (bolaoJoinBtn2) {
      bolaoJoinBtn2.addEventListener('click', async () => {
        const lead = getSavedLead(); if (!lead) { alert('Cadastre-se primeiro!'); return; }
        const codeInput = document.getElementById('bolao-join-code'); const code = codeInput.value.trim().toUpperCase();
        if (!code) { alert('Digite o codigo do grupo!'); codeInput.focus(); return; }
        bolaoJoinBtn2.textContent = 'Entrando...'; bolaoJoinBtn2.disabled = true;
        const rawUrl = supabaseUrl || ''; const anonKey = supabaseAnonKey || '';
        let cleanUrl = rawUrl.trim().replace(/\/rest\/v1\/?$/, '').replace(/\/$/, '');
        let groupId = null; let groupName = code;
        try {
          if (cleanUrl && anonKey) {
            const gr = await fetch(cleanUrl+'/rest/v1/grupos?codigo_acesso=eq.'+code+'&select=id,nome&limit=1', { headers:{'apikey':anonKey,'Authorization':'Bearer '+anonKey} });
            const gd = await gr.json();
            if (!gd||gd.length===0) { alert('Codigo invalido. Verifique com quem te convidou!'); bolaoJoinBtn2.textContent='Entrar'; bolaoJoinBtn2.disabled=false; return; }
            groupId=gd[0].id; groupName=gd[0].nome;
            const lr = await fetch(cleanUrl+'/rest/v1/leads?email=eq.'+encodeURIComponent(lead.email)+'&select=id&limit=1', { headers:{'apikey':anonKey,'Authorization':'Bearer '+anonKey} });
            const ld = await lr.json(); const leadId = ld[0]&&ld[0].id;
            if (!leadId) throw new Error('Lead nao encontrado.');
            await fetch(cleanUrl+'/rest/v1/grupo_membros', { method:'POST', headers:{'apikey':anonKey,'Authorization':'Bearer '+anonKey,'Content-Type':'application/json','Prefer':'return=minimal'}, body: JSON.stringify({grupo_id:groupId,lead_id:leadId}) });
            await recordEngagementEvent('group_joined', 5, `group_joined:${leadId}:${groupId}`, {
              leadId,
              groupId,
              groupName,
              codigo: code
            });
          }
        } catch(err) { console.error('Erro entrar grupo:', err); }
        const sg = getSavedGroups(); if (!sg.some(g => g.codigo===code)) { sg.push({nome:groupName,codigo:code,id:groupId||code}); saveGroups(sg); }
        codeInput.value = ''; bolaoJoinBtn2.textContent = 'Entrar'; bolaoJoinBtn2.disabled = false;
        renderMyGroups(); alert('Voce entrou no grupo "'+groupName+'"!');
      });
    }
    const refCopyBtn = document.getElementById('ref-copy-btn');
    if (refCopyBtn) {
      refCopyBtn.addEventListener('click', () => {
        const refLinkInput = document.getElementById('ref-link-input');
        if (refLinkInput) {
          navigator.clipboard.writeText(refLinkInput.value).then(() => {
            const originalText = refCopyBtn.textContent;
            refCopyBtn.textContent = '✅ Copiado!';
            setTimeout(() => { refCopyBtn.textContent = originalText; }, 2500);
          });
        }
      });
    }

    const urlParams = new URLSearchParams(window.location.search);
    const refParam = urlParams.get('ref');
    if (refParam) {
      localStorage.setItem('ref_code_convite', refParam.toUpperCase());
    }

    document.querySelectorAll('.tab-btn[data-tab="bolao"]').forEach(btn => { btn.addEventListener('click', initBolao); });
    const urlBolaoCode = new URLSearchParams(window.location.search).get('bolao');
    if (urlBolaoCode) { const ji = document.getElementById('bolao-join-code'); if (ji) ji.value = urlBolaoCode.toUpperCase(); const bt = document.querySelector('[data-tab="bolao"]'); if (bt) bt.click(); }

    // Start everything
    async function initApp() {
      // Welcome Carousel Logic
      const welcomeModal = document.getElementById('welcome-modal');
      const slides = document.querySelectorAll('.carousel-slide');
      const dots = document.querySelectorAll('.carousel-dots .dot');
      const nextBtn = document.getElementById('welcome-next-btn');
      let currentSlide = 0;

      function showSlide(index) {
        slides.forEach((s, i) => s.style.display = i === index ? 'block' : 'none');
        dots.forEach((d, i) => d.classList.toggle('active', i === index));
        if (index === slides.length - 1) {
          nextBtn.textContent = 'Começar! 🎉';
        } else {
          nextBtn.innerHTML = 'Próximo ➔';
        }
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          if (currentSlide < slides.length - 1) {
            currentSlide++;
            showSlide(currentSlide);
          } else {
            welcomeModal.classList.remove('active');
            localStorage.setItem('hasSeenWelcome', 'true');
          }
        });
      }

      if (!localStorage.getItem('hasSeenWelcome') && welcomeModal) {
        setTimeout(() => welcomeModal.classList.add('active'), 800);
      }

      loadLocalState();
      
      try {
        let cleanUrl = (supabaseUrl || '').trim().replace(/\/rest\/v1\/?$/, '').replace(/\/$/, '');
        if (cleanUrl && supabaseAnonKey) {
          const res = await fetch(cleanUrl + '/rest/v1/resultados_reais?select=*', {
            headers: { 'apikey': supabaseAnonKey, 'Authorization': 'Bearer ' + supabaseAnonKey }
          });
          if (res.ok) {
            const realData = await res.json();
            realData.forEach(rr => {
              if (rr.status === 'FINISHED' || rr.status === 'IN_PLAY') {
                const m = matches.find(x => x.id === rr.match_id);
                if (m) {
                  m.userHomeScore = m.homeScore;
                  m.userAwayScore = m.awayScore;
                  m.homeScore = rr.home_score;
                  m.awayScore = rr.away_score;
                  m.isFinished = (rr.status === 'FINISHED');
                }
              }
            });
            // Also override the saveLocalState function so it doesn't overwrite real results?
            // saveLocalState just serializes the current `matches` state, which now includes the real results!
            // Wait, this means user's local sim_data will start including the real results. This is correct!
          }
        }
      } catch(e) { console.error('Erro ao buscar resultados reais', e); }

      // Buscar artilheiros oficiais do Supabase (sincronizados via api-football.com)
      try {
        let cleanUrl = (supabaseUrl || '').trim().replace(/\/rest\/v1\/?$/, '').replace(/\/$/, '');
        if (cleanUrl && supabaseAnonKey) {
          const artRes = await fetch(cleanUrl + '/rest/v1/artilheiros_reais?select=*&order=goals.desc&limit=20', {
            headers: { 'apikey': supabaseAnonKey, 'Authorization': 'Bearer ' + supabaseAnonKey }
          });
          if (artRes.ok) {
            const artData = await artRes.json();
            artilheirosReais = artData.map(a => ({
              name: a.player_name,
              teamCode: a.team_code,
              teamName: a.team_name,
              goals: a.goals,
              assists: a.assists || 0,
              photo: a.player_photo || null,
            }));
            console.log(`⚽ ${artilheirosReais.length} artilheiro(s) carregados do Supabase.`);
          }
        }
      } catch(e) { console.error('Erro ao buscar artilheiros reais', e); }

      initGroups();
      calculateQualifiedTeams();
      renderArtilharia();
      parseUrlParams();
    }
    initApp();
  </script>
</Layout>

