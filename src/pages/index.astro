---
import Layout from '../layouts/Layout.astro';
import { teams, groups, generateMatches, validateWorldCupData } from '../data/worldCupData';

const initialMatches = generateMatches();
validateWorldCupData(); // Auto-auditoria em tempo de build

// Supabase environment variables from server environment
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---

<Layout title="Copa do Mundo FIFA 2026 — Tabela, Jogos e Resultados ao Vivo" description="Acompanhe a Tabela da Copa do Mundo 2026 em tempo real! Confira jogos de hoje, resultados de ontem, classificação dos grupos, chaveamento do mata-mata e artilharia oficial.">
  <main class="container">
    
    <!-- HEADER -->
    <header>
      <img src="/logo-copa.png" alt="FIFA World Cup 2026 Logo" class="official-logo" style="width: 110px; height: auto; margin: 0 auto 1rem auto; display: block;" />
      <div class="logo-badge">América do Norte 2026</div>
      <h1>Copa do Mundo 2026</h1>
      <div id="live-indicator" class="live-indicator-badge" style="display: none;">
        <span class="live-dot"></span> JOGO AO VIVO
      </div>
      <p class="subtitle">Confira os jogos de ontem e hoje, classificação dos grupos, chaveamento do mata-mata e a artilharia da Copa em tempo real.</p>
    </header>

    <!-- VIEW 0: JOGOS (ONTEM E HOJE) -->
    <section id="jogos-dia" class="view-panel active">
      <div class="refresh-bar">
        <span id="last-update-label" style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Carregando resultados...</span>
        <button id="refresh-scores-btn" class="refresh-btn" title="Atualizar dados agora">
          <span id="refresh-icon">🔄</span> Atualizar
        </button>
      </div>

      <div class="games-layout">
        <!-- Main matches area (Yesterday & Today) -->
        <div style="display: flex; flex-direction: column; gap: 2rem;">
          
          <!-- TODAY'S MATCHES -->
          <div class="glass-card" style="padding: 1.5rem;">
            <h2 class="panel-title">📅 Jogos de Hoje</h2>
            <div class="matches-list" id="today-matches-container">
              <!-- Populated via JS -->
            </div>
          </div>

          <!-- YESTERDAY'S MATCHES -->
          <div class="glass-card" style="padding: 1.5rem;">
            <h2 class="panel-title purple">⬅️ Resultados de Ontem</h2>
            <div class="matches-list" id="yesterday-matches-container">
              <!-- Populated via JS -->
            </div>
          </div>
          
        </div>

        <!-- Sidebar (Upcoming Matches) -->
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
          <div class="glass-card" style="padding: 1.5rem;" id="upcoming-matches-section">
            <h2 class="panel-title cyan">⏰ Próximos Jogos</h2>
            <div class="upcoming-matches-grid" id="upcoming-matches-container">
              <!-- Populated via JS -->
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VIEW 1: TABELA DA COPA (GRUPOS) -->
    <section id="fase-grupos" class="view-panel">
      <div class="groups-grid">
        {groups.map(groupLetter => (
          <div class="glass-card group-card" data-group={groupLetter}>
            <div class="group-card-header">
              <span class="group-card-title">Grupo {groupLetter}</span>
              <span class="group-card-subtitle">FIFA 2026</span>
            </div>
            
            <!-- Standings Table -->
            <table class="standing-table">
              <thead>
                <tr>
                  <th class="align-left">Seleção</th>
                  <th>P</th>
                  <th>J</th>
                  <th>V</th>
                  <th>SG</th>
                </tr>
              </thead>
              <tbody class="group-standings-body" id={`standings-${groupLetter}`}>
                <!-- Populated via JS -->
              </tbody>
            </table>

            <!-- Group Matches -->
            <div class="matches-list" id={`matches-${groupLetter}`}>
              <!-- Populated via JS -->
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- VIEW 2: MATA-MATA (CHAVEAMENTO MOBILE-OPTIMIZED) -->
    <section id="mata-mata" class="view-panel">
      <!-- Seletor de fases para mobile/desktop -->
      <div class="bracket-navigation">
        <button class="bracket-nav-btn active" data-round="0">32-avos</button>
        <button class="bracket-nav-btn" data-round="1">Oitavas</button>
        <button class="bracket-nav-btn" data-round="2">Quartas</button>
        <button class="bracket-nav-btn" data-round="3">Semifinais</button>
        <button class="bracket-nav-btn" data-round="4">Final</button>
      </div>

      <div class="bracket-content">
        <!-- Round of 32 -->
        <div class="bracket-round-view active" id="round-32">
          <h3 class="text-center text-muted text-xs font-bold uppercase tracking-wider mb-4" style="text-align: center; margin-bottom: 1.5rem; color: var(--color-purple);">Dezesseis-avos (32 seleções)</h3>
          <!-- Populated via JS -->
        </div>

        <!-- Round of 16 -->
        <div class="bracket-round-view" id="round-16">
          <h3 class="text-center text-muted text-xs font-bold uppercase tracking-wider mb-4" style="text-align: center; margin-bottom: 1.5rem; color: var(--color-purple);">Oitavas de Final</h3>
          <!-- Populated via JS -->
        </div>

        <!-- Quarter Finals -->
        <div class="bracket-round-view" id="round-8">
          <h3 class="text-center text-muted text-xs font-bold uppercase tracking-wider mb-4" style="text-align: center; margin-bottom: 1.5rem; color: var(--color-purple);">Quartas de Final</h3>
          <!-- Populated via JS -->
        </div>

        <!-- Semi Finals -->
        <div class="bracket-round-view" id="round-4">
          <h3 class="text-center text-muted text-xs font-bold uppercase tracking-wider mb-4" style="text-align: center; margin-bottom: 1.5rem; color: var(--color-purple);">Semifinais</h3>
          <!-- Populated via JS -->
        </div>

        <!-- Final -->
        <div class="bracket-round-view" id="round-2">
          <h3 class="text-center text-muted text-xs font-bold uppercase tracking-wider mb-4" style="text-align: center; margin-bottom: 1.5rem; color: var(--color-purple);">Grande Final</h3>
          <!-- Populated via JS -->
        </div>
      </div>

      <!-- Champion Display Banner -->
      <div class="champion-banner" id="champion-display">
        <h3 class="champion-title">🏆 CAMPEÃO DO MUNDO 2026 🏆</h3>
        <img src="" alt="Bandeira do Campeão" class="champion-flag" id="champion-flag-img" />
        <div class="champion-team-name" id="champion-team-name">-</div>
        <p class="text-muted text-sm">Chaveamento completo atualizado automaticamente pelos placares oficiais.</p>
      </div>
    </section>

    <!-- VIEW 3: ARTILHARIA (PÓDIO + LEADERBOARD) -->
    <section id="artilharia" class="view-panel">
      <div class="artilharia-panel">
        
        <!-- Podium -->
        <div class="podium-container" id="podium-container">
          <!-- 2nd Place -->
          <div class="podium-column second" id="podium-second" style="visibility: hidden;">
            <!-- Rendered via JS -->
          </div>
          <!-- 1st Place -->
          <div class="podium-column first" id="podium-first" style="visibility: hidden;">
            <!-- Rendered via JS -->
          </div>
          <!-- 3rd Place -->
          <div class="podium-column third" id="podium-third" style="visibility: hidden;">
            <!-- Rendered via JS -->
          </div>
        </div>

        <!-- Other Scorers List -->
        <div class="glass-card scorers-table-card" id="scorers-table-card">
          <h2 class="panel-title" style="margin-bottom: 1rem;">👟 Tabela de Artilheiros</h2>
          <table class="standing-table" style="font-size: 0.9rem;">
            <thead>
              <tr>
                <th class="align-left">Jogador</th>
                <th class="align-left">Seleção</th>
                <th>Gols</th>
              </tr>
            </thead>
            <tbody id="artilharia-body">
              <!-- Populated via JS -->
            </tbody>
          </table>
        </div>

        <div id="no-scorers-msg" class="glass-card text-center text-muted" style="padding: 3rem 1.5rem; text-align: center;">
          ⚽ A lista de artilheiros oficial será atualizada automaticamente em tempo real assim que os primeiros gols da Copa forem marcados!
        </div>
      </div>
    </section>

    <!-- DESKTOP TOP NAV TABS -->
    <div class="tabs-container">
      <button class="tab-btn active" data-tab="jogos-dia">📅 Jogos</button>
      <button class="tab-btn" data-tab="fase-grupos">📋 Tabela</button>
      <button class="tab-btn" data-tab="mata-mata">🏆 Mata-Mata</button>
      <button class="tab-btn" data-tab="artilharia">👟 Artilharia</button>
    </div>

    <!-- MOBILE BOTTOM NAV BAR -->
    <div class="mobile-nav-bar">
      <button class="mobile-nav-btn active" data-tab="jogos-dia">
        <span class="mobile-nav-btn-icon">📅</span>
        <span>Jogos</span>
      </button>
      <button class="mobile-nav-btn" data-tab="fase-grupos">
        <span class="mobile-nav-btn-icon">📋</span>
        <span>Tabelas</span>
      </button>
      <button class="mobile-nav-btn" data-tab="mata-mata">
        <span class="mobile-nav-btn-icon">🏆</span>
        <span>Mata-Mata</span>
      </button>
      <button class="mobile-nav-btn" data-tab="artilharia">
        <span class="mobile-nav-btn-icon">👟</span>
        <span>Artilharia</span>
      </button>
    </div>

    <!-- MODAL SQUAD DETAILS -->
    <div class="modal-overlay" id="squad-modal">
      <div class="glass-card modal-content">
        <button class="close-modal-btn" id="close-squad-modal">&times;</button>
        <h3 class="modal-title" id="squad-modal-title">Elenco</h3>
        <div class="squad-players-grid" id="squad-players-list">
          <!-- Populated via JS -->
        </div>
      </div>
    </div>

    <!-- FOOTER -->
    <footer style="margin-top: 4rem;">
      <p>&copy; 2026 Tabela da Copa do Mundo 2026. Todos os dados são de caráter informativo.</p>
    </footer>
  </main>

  <!-- CLIENT-SIDE LOGIC -->
  <script is:inline define:vars={{ initialMatches, teams, groups, supabaseUrl, supabaseAnonKey }}>
    // Error Logging helpers
    window.onerror = function(msg, url, line, col, error) {
      console.error("JS Error: ", msg, "Line: ", line, "Stack: ", error ? error.stack : '');
    };
    window.onunhandledrejection = function(event) {
      console.error("Unhandled Promise Rejection: ", event.reason);
    };

    let matches = JSON.parse(JSON.stringify(initialMatches));
    let artilheirosReais = [];
    let bracket = Array.from({ length: 31 }, () => ({
      homeId: null, awayId: null, homeScore: null, awayScore: null, isFinished: false, isInPlay: false
    }));

    let activeBracketRound = 0; // 0 = R32, 1 = R16, 2 = QF, 3 = SF, 4 = Final

    // Navigation Selectors
    const desktopTabs = document.querySelectorAll('.tab-btn');
    const mobileTabs = document.querySelectorAll('.mobile-nav-btn');
    const panels = document.querySelectorAll('.view-panel');
    const squadModal = document.getElementById('squad-modal');
    const closeSquadModal = document.getElementById('close-squad-modal');

    // Tab switcher
    function switchTab(tabId) {
      desktopTabs.forEach(t => t.classList.toggle('active', t.dataset.tab === tabId));
      mobileTabs.forEach(t => t.classList.toggle('active', t.dataset.tab === tabId));
      panels.forEach(p => p.classList.toggle('active', p.id === tabId));
      
      if (tabId === 'mata-mata') {
        renderBracket();
      }
    }

    desktopTabs.forEach(tab => {
      tab.addEventListener('click', () => switchTab(tab.dataset.tab));
    });

    mobileTabs.forEach(tab => {
      tab.addEventListener('click', () => switchTab(tab.dataset.tab));
    });

    // Bracket Nav button switcher
    const bracketNavBtns = document.querySelectorAll('.bracket-nav-btn');
    bracketNavBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        bracketNavBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeBracketRound = parseInt(btn.dataset.round, 10);
        renderBracket();
      });
    });

    // Helper: Country Flags URL (Large flags for better aesthetics)
    function getFlagUrl(code) {
      if (code === 'gb-eng') return 'https://flagcdn.com/w80/gb-eng.png';
      return `https://flagcdn.com/w80/${code.toLowerCase()}.png`;
    }

    // Helper: Parse Datetime in Brasilia UTC-3
    function parseDatetime(dtStr) {
      try {
        const parts = dtStr.split(' – ');
        const datePart = parts[0].split(' ')[0]; // "dd/mm/yyyy"
        const timePart = parts[1]; // "hh:mm"
        const [day, month, year] = datePart.split('/').map(Number);
        const [hours, minutes] = timePart.split(':').map(Number);
        const utcDateStr = `${year}-${String(month).padStart(2,'0')}-${String(day).padStart(2,'0')}T${String(hours).padStart(2,'0')}:${String(minutes).padStart(2,'0')}:00-03:00`;
        return new Date(utcDateStr);
      } catch (e) {
        return null;
      }
    }

    // Render single match card HTML
    function getMatchCardHTML(match, forceShowScore = false) {
      const homeTeam = teams[match.homeId];
      const awayTeam = teams[match.awayId];
      
      const showScore = match.isFinished || match.isInPlay || forceShowScore;
      const hScore = showScore ? (match.homeScore !== null ? match.homeScore : 0) : '-';
      const aScore = showScore ? (match.awayScore !== null ? match.awayScore : 0) : '-';

      const statusBadge = match.isFinished
        ? '<span style="color: var(--color-primary); font-weight: bold; font-size: 0.65rem; margin-left: 0.5rem; border: 1px solid var(--color-primary); padding: 2px 6px; border-radius: 10px; background: rgba(0,255,135,0.08); display: inline-block; white-space: nowrap; vertical-align: middle;">✅ Final</span>'
        : match.isInPlay
        ? '<span style="color: var(--color-danger); font-weight: bold; font-size: 0.65rem; margin-left: 0.5rem; border: 1px solid var(--color-danger); padding: 2px 6px; border-radius: 10px; background: rgba(239,68,68,0.12); display: inline-block; white-space: nowrap; vertical-align: middle; animation: blink 1s infinite;">🔴 AO VIVO</span>'
        : '';

      const homeRank = window.teamRanks?.[match.homeId] ? `<span class="team-rank">#${window.teamRanks[match.homeId]}</span>` : '';
      const awayRank = window.teamRanks?.[match.awayId] ? `<span class="team-rank">#${window.teamRanks[match.awayId]}</span>` : '';

      return `
        <div class="match-info-top">
          <span class="phase-badge">${match.group ? 'Grupo ' + match.group : 'Mata-Mata'}</span>
          <span class="match-datetime">${match.datetime || ''} ${statusBadge}</span>
        </div>
        <div class="match-row">
          <div class="match-team home">
            <span class="team-name-large" data-team-id="${match.homeId}">${homeTeam.name}</span>
            ${homeRank}
            <img src="${getFlagUrl(homeTeam.code)}" alt="${homeTeam.name}" class="flag-large" />
          </div>
          
          <div class="score-display-container">
            <div class="score-box ${match.isInPlay ? 'live' : ''}">${hScore}</div>
            <span class="match-vs-divider">X</span>
            <div class="score-box ${match.isInPlay ? 'live' : ''}">${aScore}</div>
          </div>
          
          <div class="match-team away">
            <img src="${getFlagUrl(awayTeam.code)}" alt="${awayTeam.name}" class="flag-large" />
            ${awayRank}
            <span class="team-name-large" data-team-id="${match.awayId}">${awayTeam.name}</span>
          </div>
        </div>
        <div class="match-venue-text" style="text-align: center; margin-top: 0.5rem; font-size: 0.75rem; color: var(--text-dark);">
          🏟️ ${match.stadium || ''}, ${match.city || ''}
        </div>
      `;
    }

    // Render Jogos (Ontem e Hoje)
    function renderJogosDoDia() {
      const todayContainer = document.getElementById('today-matches-container');
      const yesterdayContainer = document.getElementById('yesterday-matches-container');
      if (!todayContainer || !yesterdayContainer) return;

      const now = new Date();
      // Format as DD/MM/YYYY
      const todayStr = String(now.getDate()).padStart(2, '0') + '/' + String(now.getMonth() + 1).padStart(2, '0') + '/' + now.getFullYear();
      
      const yesterday = new Date(now);
      yesterday.setDate(yesterday.getDate() - 1);
      const yesterdayStr = String(yesterday.getDate()).padStart(2, '0') + '/' + String(yesterday.getMonth() + 1).padStart(2, '0') + '/' + yesterday.getFullYear();

      const todayMatches = matches.filter(m => m.datetime.startsWith(todayStr));
      const yesterdayMatches = matches.filter(m => m.datetime.startsWith(yesterdayStr));

      todayMatches.sort((a, b) => a.datetime.localeCompare(b.datetime));
      yesterdayMatches.sort((a, b) => a.datetime.localeCompare(b.datetime));

      todayContainer.innerHTML = '';
      yesterdayContainer.innerHTML = '';

      if (todayMatches.length === 0) {
        todayContainer.innerHTML = '<p class="text-center text-muted" style="padding: 1.5rem; text-align: center;">Nenhum jogo programado para hoje.</p>';
      } else {
        todayMatches.forEach(match => {
          const card = document.createElement('div');
          card.className = 'match-card';
          card.innerHTML = getMatchCardHTML(match, false);
          todayContainer.appendChild(card);
        });
      }

      if (yesterdayMatches.length === 0) {
        yesterdayContainer.innerHTML = '<p class="text-center text-muted" style="padding: 1.5rem; text-align: center;">Nenhum jogo ocorreu ontem.</p>';
      } else {
        yesterdayMatches.forEach(match => {
          const card = document.createElement('div');
          card.className = 'match-card';
          card.innerHTML = getMatchCardHTML(match, true);
          yesterdayContainer.appendChild(card);
        });
      }
    }

    // Render Upcoming Matches Grid (next 3)
    function renderUpcomingMatches() {
      const container = document.getElementById('upcoming-matches-container');
      const section = document.getElementById('upcoming-matches-section');
      if (!container || !section) return;

      const now = new Date();
      const future = matches
        .filter(m => !m.isFinished && !m.isInPlay)
        .map(m => ({ match: m, date: parseDatetime(m.datetime) }))
        .filter(x => x.date !== null && x.date > now)
        .sort((a, b) => a.date - b.date)
        .slice(0, 4);

      if (future.length === 0) {
        section.style.display = 'none';
        return;
      }

      section.style.display = 'block';
      container.innerHTML = '';

      future.forEach(({ match }) => {
        const homeTeam = teams[match.homeId];
        const awayTeam = teams[match.awayId];
        const phaseName = match.group ? `Grupo ${match.group}` : 'Mata-Mata';

        const card = document.createElement('div');
        card.className = 'upcoming-match-card';
        card.innerHTML = `
          <div class="upcoming-header">
            <span class="upcoming-badge">${phaseName}</span>
            <span class="upcoming-time">${match.datetime.split(' – ')[1]}</span>
          </div>
          <div class="upcoming-teams-row">
            <div class="upcoming-team-item">
              <img src="${getFlagUrl(homeTeam.code)}" alt="" class="flag-small" />
              <span>${homeTeam.name}</span>
            </div>
            <span style="color: var(--text-dark); font-size: 0.75rem; font-weight: 800;">VS</span>
            <div class="upcoming-team-item" style="flex-direction: row-reverse;">
              <img src="${getFlagUrl(awayTeam.code)}" alt="" class="flag-small" />
              <span>${awayTeam.name}</span>
            </div>
          </div>
          <div class="upcoming-venue-text">
            📅 ${match.datetime.split(' – ')[0]} | 🏟️ ${match.stadium}, ${match.city}
          </div>
        `;
        container.appendChild(card);
      });
    }

    // Render live indicator in header
    function renderLiveIndicator() {
      const indicatorEl = document.getElementById('live-indicator');
      if (!indicatorEl) return;
      const isAnyLive = matches.some(m => m.isInPlay) || bracket.some(m => m && m.isInPlay);
      indicatorEl.style.display = isAnyLive ? 'inline-flex' : 'none';
    }

    // Initialize & render all groups
    function initGroups() {
      groups.forEach(groupLetter => {
        updateGroupStandings(groupLetter);

        const matchesContainer = document.getElementById(`matches-${groupLetter}`);
        if (matchesContainer) {
          matchesContainer.innerHTML = '';
          const groupMatches = matches.filter(m => m.group === groupLetter);
          groupMatches.forEach(match => {
            const matchCard = document.createElement('div');
            matchCard.className = 'match-card';
            matchCard.innerHTML = getMatchCardHTML(match);
            matchesContainer.appendChild(matchCard);
          });
        }
      });

      renderJogosDoDia();
      renderUpcomingMatches();
    }

    // Recalculate Group Standings
    function updateGroupStandings(groupLetter) {
      const groupTeams = Object.keys(teams)
        .filter(key => teams[key].group === groupLetter)
        .map(key => ({
          id: key,
          name: teams[key].name,
          code: teams[key].code,
          p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, gd: 0, pts: 0, games: 0
        }));

      const groupMatches = matches.filter(m => m.group === groupLetter);

      groupMatches.forEach(m => {
        if (m.homeScore !== null && m.awayScore !== null) {
          const home = groupTeams.find(t => t.id === m.homeId);
          const away = groupTeams.find(t => t.id === m.awayId);

          if (home && away) {
            home.games += 1;
            away.games += 1;
            home.gf += m.homeScore;
            home.ga += m.awayScore;
            away.gf += m.awayScore;
            away.ga += m.homeScore;
            
            home.gd = home.gf - home.ga;
            away.gd = away.gf - away.ga;

            if (m.homeScore > m.awayScore) {
              home.pts += 3;
              home.w += 1;
              away.l += 1;
            } else if (m.homeScore < m.awayScore) {
              away.pts += 3;
              away.w += 1;
              home.l += 1;
            } else {
              home.pts += 1;
              away.pts += 1;
              home.d += 1;
              away.d += 1;
            }
          }
        }
      });

      // Sort group rules: Points -> GD -> GF -> Alphabetical
      groupTeams.sort((a, b) => {
        if (b.pts !== a.pts) return b.pts - a.pts;
        if (b.gd !== a.gd) return b.gd - a.gd;
        if (b.gf !== a.gf) return b.gf - a.gf;
        return a.name.localeCompare(b.name);
      });

      if (!window.teamRanks) window.teamRanks = {};
      groupTeams.forEach((t, idx) => {
        window.teamRanks[t.id] = idx + 1;
      });

      const tableBody = document.getElementById(`standings-${groupLetter}`);
      if (tableBody) {
        tableBody.innerHTML = '';
        groupTeams.forEach((team, idx) => {
          let qualifyClass = '';
          if (idx < 2) qualifyClass = 'qualify-direct';
          
          const tr = document.createElement('tr');
          tr.className = qualifyClass;
          tr.innerHTML = `
            <td class="align-left">
              <div class="table-team-cell">
                <span class="text-xs text-muted font-bold" style="margin-right: 0.15rem;">${idx + 1}</span>
                <img src="${getFlagUrl(team.code)}" alt="" class="flag-small" style="width:20px; height:13px; margin:0;" />
                <span class="team-name" data-team-id="${team.id}">${team.name}</span>
              </div>
            </td>
            <td><strong>${team.pts}</strong></td>
            <td>${team.games}</td>
            <td>${team.w}</td>
            <td>${team.gd}</td>
          `;
          tableBody.appendChild(tr);
        });
      }
    }

    // Calculate Qualified Teams from Group Stage
    function calculateQualifiedTeams() {
      const groupWinners = [];
      const groupRunnersUp = [];
      const groupThirds = [];

      groups.forEach(groupLetter => {
        const groupTeams = Object.keys(teams)
          .filter(key => teams[key].group === groupLetter)
          .map(key => ({
            id: key,
            name: teams[key].name,
            code: teams[key].code,
            pts: 0, gd: 0, gf: 0, w: 0
          }));

        const groupMatches = matches.filter(m => m.group === groupLetter);
        groupMatches.forEach(m => {
          if (m.homeScore !== null && m.awayScore !== null) {
            const home = groupTeams.find(t => t.id === m.homeId);
            const away = groupTeams.find(t => t.id === m.awayId);
            
            if (home && away) {
              home.gf += m.homeScore;
              home.ga = (home.ga || 0) + m.awayScore;
              away.gf += m.awayScore;
              away.ga = (away.ga || 0) + m.homeScore;

              if (m.homeScore > m.awayScore) { home.pts += 3; home.w += 1; }
              else if (m.homeScore < m.awayScore) { away.pts += 3; away.w += 1; }
              else { home.pts += 1; away.pts += 1; }
            }
          }
        });

        groupTeams.forEach(t => t.gd = t.gf - (t.ga || 0));

        groupTeams.sort((a, b) => {
          if (b.pts !== a.pts) return b.pts - a.pts;
          if (b.gd !== a.gd) return b.gd - a.gd;
          if (b.gf !== a.gf) return b.gf - a.gf;
          return a.name.localeCompare(b.name);
        });

        groupWinners.push(groupTeams[0]);
        groupRunnersUp.push(groupTeams[1]);
        groupThirds.push(groupTeams[2]);
      });

      groupThirds.sort((a, b) => {
        if (b.pts !== a.pts) return b.pts - a.pts;
        if (b.gd !== a.gd) return b.gd - a.gd;
        if (b.gf !== a.gf) return b.gf - a.gf;
        return a.name.localeCompare(b.name);
      });

      const bestThirds = groupThirds.slice(0, 8);
      
      const pairings = [
        { home: groupWinners[0], away: bestThirds[0] }, // R32_M1
        { home: groupWinners[1], away: bestThirds[1] }, // R32_M2
        { home: groupWinners[2], away: bestThirds[2] }, // R32_M3
        { home: groupWinners[3], away: bestThirds[3] }, // R32_M4
        { home: groupWinners[4], away: bestThirds[4] }, // R32_M5
        { home: groupWinners[5], away: bestThirds[5] }, // R32_M6
        { home: groupWinners[6], away: bestThirds[6] }, // R32_M7
        { home: groupWinners[7], away: bestThirds[7] }, // R32_M8
        { home: groupWinners[8], away: groupRunnersUp[0] }, // R32_M9
        { home: groupWinners[9], away: groupRunnersUp[1] }, // R32_M10
        { home: groupWinners[10], away: groupRunnersUp[2] }, // R32_M11
        { home: groupWinners[11], away: groupRunnersUp[3] }, // R32_M12
        { home: groupRunnersUp[4], away: groupRunnersUp[5] }, // R32_M13
        { home: groupRunnersUp[6], away: groupRunnersUp[7] }, // R32_M14
        { home: groupRunnersUp[8], away: groupRunnersUp[9] }, // R32_M15
        { home: groupRunnersUp[10], away: groupRunnersUp[11] } // R32_M16
      ];

      for (let i = 0; i < 16; i++) {
        const pair = pairings[i];
        if (!bracket[i]) {
          bracket[i] = { homeId: null, awayId: null, homeScore: null, awayScore: null, isFinished: false, isInPlay: false };
        }
        bracket[i].homeId = pair.home ? pair.home.id : null;
        bracket[i].awayId = pair.away ? pair.away.id : null;
      }

      updateBracketFlow();
      renderBracket();
    }

    // Propagate winners from R32 -> R16 -> QF -> SF -> Final
    function updateBracketFlow() {
      // R16 Propagation
      for (let i = 0; i < 8; i++) {
        const matchLeft = bracket[i * 2];
        const matchRight = bracket[i * 2 + 1];
        
        if (!bracket[16 + i]) {
          bracket[16 + i] = { homeId: null, awayId: null, homeScore: null, awayScore: null, isFinished: false, isInPlay: false };
        }
        
        bracket[16 + i].homeId = getMatchWinner(matchLeft);
        bracket[16 + i].awayId = getMatchWinner(matchRight);
      }

      // QF Propagation
      for (let i = 0; i < 4; i++) {
        const matchLeft = bracket[16 + i * 2];
        const matchRight = bracket[16 + i * 2 + 1];
        
        if (!bracket[24 + i]) {
          bracket[24 + i] = { homeId: null, awayId: null, homeScore: null, awayScore: null, isFinished: false, isInPlay: false };
        }
        
        bracket[24 + i].homeId = getMatchWinner(matchLeft);
        bracket[24 + i].awayId = getMatchWinner(matchRight);
      }

      // SF Propagation
      for (let i = 0; i < 2; i++) {
        const matchLeft = bracket[24 + i * 2];
        const matchRight = bracket[24 + i * 2 + 1];
        
        if (!bracket[28 + i]) {
          bracket[28 + i] = { homeId: null, awayId: null, homeScore: null, awayScore: null, isFinished: false, isInPlay: false };
        }
        
        bracket[28 + i].homeId = getMatchWinner(matchLeft);
        bracket[28 + i].awayId = getMatchWinner(matchRight);
      }

      // Final Propagation
      const sfLeft = bracket[28];
      const sfRight = bracket[29];
      if (!bracket[30]) {
        bracket[30] = { homeId: null, awayId: null, homeScore: null, awayScore: null, isFinished: false, isInPlay: false };
      }
      bracket[30].homeId = getMatchWinner(sfLeft);
      bracket[30].awayId = getMatchWinner(sfRight);

      // Determine Champion
      const champId = getMatchWinner(bracket[30]);
      const champDisplay = document.getElementById('champion-display');
      
      if (champId && teams[champId]) {
        const flagImg = document.getElementById('champion-flag-img');
        if (flagImg) flagImg.src = getFlagUrl(teams[champId].code);
        const nameEl = document.getElementById('champion-team-name');
        if (nameEl) nameEl.textContent = teams[champId].name;
        if (champDisplay) {
          champDisplay.style.display = 'flex';
        }
      } else {
        if (champDisplay) champDisplay.style.display = 'none';
      }
    }

    function getMatchWinner(match) {
      if (!match || match.homeId === null || match.awayId === null) return null;
      if (match.homeScore === null || match.awayScore === null) return null;
      if (match.homeScore > match.awayScore) return match.homeId;
      if (match.homeScore < match.awayScore) return match.awayId;
      return match.homeId;
    }

    // Render Bracket Tree (Mobile friendly layout with tab rounds)
    function renderBracket() {
      const rounds = [
        { id: 'round-32', start: 0, count: 16, title: 'Rodada de 32' },
        { id: 'round-16', start: 16, count: 8, title: 'Oitavas de Final' },
        { id: 'round-8', start: 24, count: 4, title: 'Quartas de Final' },
        { id: 'round-4', start: 28, count: 2, title: 'Semifinais' },
        { id: 'round-2', start: 30, count: 1, title: 'Grande Final' }
      ];

      // Hide all rounds except active Round
      rounds.forEach((r, idx) => {
        const roundDiv = document.getElementById(r.id);
        if (roundDiv) {
          roundDiv.classList.toggle('active', idx === activeBracketRound);
        }
      });

      const activeRound = rounds[activeBracketRound];
      const container = document.getElementById(activeRound.id);
      if (!container) return;

      const titleEl = container.querySelector('h3');
      const titleHtml = titleEl ? titleEl.outerHTML : `<h3 style="text-align: center; margin-bottom: 1.5rem; color: var(--color-purple); font-weight: 800; text-transform: uppercase;">${activeRound.title}</h3>`;
      
      container.innerHTML = titleHtml + '<div class="bracket-list"></div>';
      const listContainer = container.querySelector('.bracket-list');

      for (let i = 0; i < activeRound.count; i++) {
        const bracketIdx = activeRound.start + i;
        const match = bracket[bracketIdx];
        
        const hasHome = match && match.homeId;
        const homeTeam = hasHome ? teams[match.homeId] : { name: 'A definir', code: 'placeholder' };
        const hasAway = match && match.awayId;
        const awayTeam = hasAway ? teams[match.awayId] : { name: 'A definir', code: 'placeholder' };

        const isHomeWinner = match && match.homeScore !== null && match.awayScore !== null && match.homeScore > match.awayScore;
        const isAwayWinner = match && match.homeScore !== null && match.awayScore !== null && match.awayScore > match.homeScore;

        const hScore = match && (match.homeScore !== null) ? match.homeScore : '-';
        const aScore = match && (match.awayScore !== null) ? match.awayScore : '-';

        const card = document.createElement('div');
        card.className = `bracket-match-card glass-card ${(!hasHome || !hasAway) ? 'pending' : ''}`;
        
        const statusText = match && match.isInPlay 
          ? '<span style="color: var(--color-danger); animation: blink 1s infinite; font-weight: 800;">🔴 AO VIVO</span>' 
          : (match && match.isFinished ? '✅ Fim' : 'A definir');

        card.innerHTML = `
          <div class="bracket-match-header">
            <span>Jogo ${i + 1}</span>
            <span>${statusText}</span>
          </div>
          <div class="bracket-match-team-row ${isHomeWinner ? 'winner' : ''} ${!hasHome ? 'team-pending' : ''}">
            <div class="bracket-match-team-info">
              ${hasHome ? `<img src="${getFlagUrl(homeTeam.code)}" class="flag-small" />` : ''}
              <span class="team-name" data-team-id="${homeTeam.id || ''}">${homeTeam.name}</span>
            </div>
            <div class="bracket-match-score">${hScore}</div>
          </div>
          <div class="bracket-match-team-row ${isAwayWinner ? 'winner' : ''} ${!hasAway ? 'team-pending' : ''}">
            <div class="bracket-match-team-info">
              ${hasAway ? `<img src="${getFlagUrl(awayTeam.code)}" class="flag-small" />` : ''}
              <span class="team-name" data-team-id="${awayTeam.id || ''}">${awayTeam.name}</span>
            </div>
            <div class="bracket-match-score">${aScore}</div>
          </div>
        `;
        listContainer.appendChild(card);
      }
    }

    // Modal: Elenco (Squad) Detail
    function showSquadModal(teamId) {
      const team = teams[teamId];
      if (!team) return;

      const titleEl = document.getElementById('squad-modal-title');
      const listContainer = document.getElementById('squad-players-list');
      if (!titleEl || !listContainer) return;

      titleEl.textContent = `Elenco — ${team.name}`;
      listContainer.innerHTML = '';

      team.players.forEach(pName => {
        const div = document.createElement('div');
        div.className = 'player-card';
        div.innerHTML = `
          <div class="player-avatar-circle">${pName.charAt(0)}</div>
          <div>
            <div class="player-name-text">${pName}</div>
            <div class="player-subtitle">Seleção Nacional</div>
          </div>
        `;
        listContainer.appendChild(div);
      });

      squadModal.classList.add('active');
    }

    if (closeSquadModal) {
      closeSquadModal.addEventListener('click', () => squadModal.classList.remove('active'));
    }

    window.addEventListener('click', (e) => {
      if (e.target === squadModal) squadModal.classList.remove('active');
    });

    // Render Podium + Golden Boot Scorers
    function renderArtilharia() {
      const podiumEl = document.getElementById('podium-container');
      const tbody = document.getElementById('artilharia-body');
      const noMsg = document.getElementById('no-scorers-msg');
      const scorersCard = document.getElementById('scorers-table-card');
      if (!tbody || !noMsg || !podiumEl || !scorersCard) return;

      tbody.innerHTML = '';

      if (artilheirosReais.length > 0) {
        noMsg.style.display = 'none';
        podiumEl.style.display = 'flex';
        scorersCard.style.display = 'block';

        // Render Podium
        const first = artilheirosReais[0];
        const second = artilheirosReais[1];
        const third = artilheirosReais[2];

        const firstCol = document.getElementById('podium-first');
        const secondCol = document.getElementById('podium-second');
        const thirdCol = document.getElementById('podium-third');

        if (firstCol) {
          if (first) {
            firstCol.style.visibility = 'visible';
            firstCol.innerHTML = `
              <div class="podium-player-photo">
                👑
                <span class="podium-medal">🥇</span>
              </div>
              <div class="podium-player-name" title="${first.name}">${first.name}</div>
              <div class="podium-player-team">
                <img src="${getFlagUrl(first.teamCode)}" class="flag-small" />
                <span>${first.teamName}</span>
              </div>
              <div class="podium-box">
                <span>1º</span>
                <span class="podium-box-score">${first.goals} Gols</span>
              </div>
            `;
          } else {
            firstCol.style.visibility = 'hidden';
          }
        }

        if (secondCol) {
          if (second) {
            secondCol.style.visibility = 'visible';
            secondCol.innerHTML = `
              <div class="podium-player-photo">
                ⚽
                <span class="podium-medal">🥈</span>
              </div>
              <div class="podium-player-name" title="${second.name}">${second.name}</div>
              <div class="podium-player-team">
                <img src="${getFlagUrl(second.teamCode)}" class="flag-small" />
                <span>${second.teamName}</span>
              </div>
              <div class="podium-box">
                <span>2º</span>
                <span class="podium-box-score">${second.goals} Gols</span>
              </div>
            `;
          } else {
            secondCol.style.visibility = 'hidden';
          }
        }

        if (thirdCol) {
          if (third) {
            thirdCol.style.visibility = 'visible';
            thirdCol.innerHTML = `
              <div class="podium-player-photo">
                let
                <span class="podium-medal">🥉</span>
              </div>
              <div class="podium-player-name" title="${third.name}">${third.name}</div>
              <div class="podium-player-team">
                <img src="${getFlagUrl(third.teamCode)}" class="flag-small" />
                <span>${third.teamName}</span>
              </div>
              <div class="podium-box">
                <span>3º</span>
                <span class="podium-box-score">${third.goals} Gols</span>
              </div>
            `;
          } else {
            thirdCol.style.visibility = 'hidden';
          }
        }

        // Render table
        const remaining = artilheirosReais.slice(3);
        if (remaining.length > 0) {
          remaining.forEach((p, idx) => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td class="align-left">
                <span class="text-xs text-muted font-bold mr-1">${idx + 4}º</span>
                <span style="font-weight: 700;">${p.name}</span>
              </td>
              <td class="align-left">
                <img src="${getFlagUrl(p.teamCode)}" class="flag-small" />
                <span>${p.teamName}</span>
              </td>
              <td><strong style="color: var(--color-primary); font-size: 1.15rem;">${p.goals}</strong></td>
            `;
            tbody.appendChild(tr);
          });
        }
      } else {
        noMsg.style.display = 'block';
        podiumEl.style.display = 'none';
        scorersCard.style.display = 'none';
      }
    }

    // Global event delegation for squad click
    document.addEventListener('click', (e) => {
      const teamEl = e.target.closest('.team-name, .team-name-large');
      if (teamEl && teamEl.dataset.teamId) {
        showSquadModal(teamEl.dataset.teamId);
      }
    });

    // Start everything
    async function initApp() {
      // ─── SUPABASE FETCH ──────────────────────────────────────────────────
      async function fetchSupabaseResults() {
        const cleanUrl = (supabaseUrl || '').trim().replace(/\/rest\/v1\/?$/, '').replace(/\/$/, '');
        if (!cleanUrl || !supabaseAnonKey) return false;

        let updated = false;
        try {
          const res = await fetch(cleanUrl + '/rest/v1/resultados_reais?select=*', {
            headers: { 'apikey': supabaseAnonKey, 'Authorization': 'Bearer ' + supabaseAnonKey }
          });
          if (res.ok) {
            const realData = await res.json();
            realData.forEach(rr => {
              if (rr.status === 'FINISHED' || rr.status === 'IN_PLAY' || rr.status === 'PAUSED') {
                const isKnockout = rr.match_id.startsWith('R32_') || rr.match_id.startsWith('R16_') || rr.match_id.startsWith('QF_') || rr.match_id.startsWith('SF_') || rr.match_id.startsWith('FNL_');
                if (isKnockout) {
                  let idx = -1;
                  const parts = rr.match_id.split('_M');
                  if (parts.length > 1) {
                    const matchNum = parseInt(parts[1], 10) - 1;
                    if (rr.match_id.startsWith('R32_')) idx = 0 + matchNum;
                    else if (rr.match_id.startsWith('R16_')) idx = 16 + matchNum;
                    else if (rr.match_id.startsWith('QF_')) idx = 24 + matchNum;
                    else if (rr.match_id.startsWith('SF_')) idx = 28 + matchNum;
                    else if (rr.match_id.startsWith('FNL_')) idx = 30 + matchNum;
                  }

                  if (idx >= 0 && idx < 31) {
                    if (!bracket[idx]) {
                      bracket[idx] = { homeId: null, awayId: null, homeScore: null, awayScore: null, isFinished: false, isInPlay: false };
                    }
                    const prevHome = bracket[idx].homeScore;
                    const prevAway = bracket[idx].awayScore;
                    bracket[idx].homeScore = rr.home_score;
                    bracket[idx].awayScore = rr.away_score;
                    bracket[idx].isFinished = (rr.status === 'FINISHED');
                    bracket[idx].isInPlay = (rr.status === 'IN_PLAY' || rr.status === 'PAUSED');
                    if (prevHome !== rr.home_score || prevAway !== rr.away_score) updated = true;
                  }
                } else {
                  const m = matches.find(x => x.id === rr.match_id);
                  if (m) {
                    const prevHome = m.homeScore;
                    const prevAway = m.awayScore;
                    m.homeScore = rr.home_score;
                    m.awayScore = rr.away_score;
                    m.isFinished = (rr.status === 'FINISHED');
                    m.isInPlay = (rr.status === 'IN_PLAY' || rr.status === 'PAUSED');
                    if (prevHome !== rr.home_score || prevAway !== rr.away_score) updated = true;
                  }
                }
              }
            });
            
            const lbl = document.getElementById('last-update-label');
            if (lbl) {
              const now = new Date();
              const h = String(now.getHours()).padStart(2,'0');
              const min = String(now.getMinutes()).padStart(2,'0');
              const s = String(now.getSeconds()).padStart(2,'0');
              lbl.textContent = `⏱ Atualizado às ${h}:${min}:${s}`;
            }
          }
        } catch(e) { 
          console.error('Erro ao buscar resultados reais', e); 
        }
        return updated;
      }

      async function fetchSupabaseScorers() {
        const cleanUrl = (supabaseUrl || '').trim().replace(/\/rest\/v1\/?$/, '').replace(/\/$/, '');
        if (!cleanUrl || !supabaseAnonKey) return;
        try {
          const artRes = await fetch(cleanUrl + '/rest/v1/artilheiros_reais?select=*&order=goals.desc&limit=20', {
            headers: { 'apikey': supabaseAnonKey, 'Authorization': 'Bearer ' + supabaseAnonKey }
          });
          if (artRes.ok) {
            const artData = await artRes.json();
            artilheirosReais = artData.map(a => ({
              name: a.player_name,
              teamCode: a.team_code,
              teamName: a.team_name,
              goals: a.goals,
              assists: a.assists || 0,
              photo: a.player_photo || null,
            }));
          }
        } catch(e) { 
          console.error('Erro ao buscar artilheiros reais', e); 
        }
      }

      await fetchSupabaseResults();
      await fetchSupabaseScorers();

      initGroups();
      calculateQualifiedTeams();
      renderArtilharia();
      renderLiveIndicator();

      // ─── POLLING AUTOMATICO ──────────────────────────────────────────────
      let pollTimeoutId = null;
      async function runPolling() {
        await fetchSupabaseResults();
        await fetchSupabaseScorers();
        
        groups.forEach(g => updateGroupStandings(g));
        calculateQualifiedTeams();
        renderArtilharia();
        renderJogosDoDia();
        renderLiveIndicator();
        renderUpcomingMatches();

        const isAnyLive = matches.some(m => m.isInPlay) || bracket.some(m => m && m.isInPlay);
        const interval = isAnyLive ? 30_000 : 60_000;
        pollTimeoutId = setTimeout(runPolling, interval);
      }
      runPolling();

      // ─── BOTAO DE REFRESH MANUAL ─────────────────────────────────────────
      const refreshBtn = document.getElementById('refresh-scores-btn');
      const refreshIcon = document.getElementById('refresh-icon');
      if (refreshBtn) {
        refreshBtn.addEventListener('click', async () => {
          refreshBtn.disabled = true;
          if (refreshIcon) refreshIcon.style.animation = 'spin 0.8s linear infinite';
          if (pollTimeoutId) clearTimeout(pollTimeoutId);
          
          await fetchSupabaseResults();
          await fetchSupabaseScorers();
          
          groups.forEach(g => updateGroupStandings(g));
          calculateQualifiedTeams();
          renderArtilharia();
          renderJogosDoDia();
          renderLiveIndicator();
          renderUpcomingMatches();
          
          if (refreshIcon) refreshIcon.style.animation = '';
          refreshBtn.disabled = false;
          
          const isAnyLive = matches.some(m => m.isInPlay) || bracket.some(m => m && m.isInPlay);
          const interval = isAnyLive ? 30_000 : 60_000;
          pollTimeoutId = setTimeout(runPolling, interval);
        });
      }
    }

    initApp();
  </script>
</Layout>
