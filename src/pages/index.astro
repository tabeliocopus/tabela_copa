    // COMPARTILHAR / LEAD GATE
    let pendingAction = null;
    let leadModalTriggered = false;

    function triggerLeadCaptureModal(reason = '') {
      if (leadModalTriggered) return;
      if (localStorage.getItem('lead_cadastrado')) return;

      leadModalTriggered = true;
      console.log('Lead capture modal triggered due to:', reason);
      if (leadModal) leadModal.classList.add('active');
    }

    function checkRegistrationAndExecute(action) {
      const isRegistered = localStorage.getItem('lead_cadastrado');
      if (isRegistered) {
        executeAction(action);
      } else {
        pendingAction = action;
        triggerLeadCaptureModal('user_action_' + action);
      }
    }

    function getLegacyShareUrl() {
      return `${window.location.origin}${window.location.pathname}`;
    }

    function appendRefCode(urlStr) {
      const lead = getSavedLead();
      if (lead?.refCode && urlStr) {
        if (urlStr.includes('ref=')) return urlStr;
        const separator = urlStr.includes('?') ? '&' : '?';
        return `${urlStr}${separator}ref=${lead.refCode}`;
      }
      return urlStr;
    }

    function getShareUrl() {
      const lead = getSavedLead();
      const rawUrl = lead?.predictionUrl || lead?.url || getLegacyShareUrl();
      return appendRefCode(rawUrl);
    }

    function getCleanSupabaseUrl() {
      return (supabaseUrl || '').trim().replace(/\/rest\/v1\/?$/, '').replace(/\/$/, '');
    }

    function generatePredictionSlug() {
      const randomPart = Math.random().toString(36).slice(2, 8);
      const timePart = Date.now().toString(36).slice(-4);
      return `${randomPart}${timePart}`.toLowerCase();
    }

    function getTeamName(teamId) {
      return teamId && teams[teamId] ? teams[teamId].name : null;
    }

    function getSimulationSnapshot() {
      const finalMatch = bracket[30];
      const championId = getMatchWinner(finalMatch);
      let runnerUpId = null;

      if (finalMatch && championId) {
        runnerUpId = championId === finalMatch.homeId ? finalMatch.awayId : finalMatch.homeId;
      }

      return {
        champion: getTeamName(championId),
        runnerUp: getTeamName(runnerUpId),
        topScorers: artilheirosReais.slice(0, 5),
        matches,
        bracket
      };
    }

    async function findLeadIdByEmail(email) {
      const cleanUrl = getCleanSupabaseUrl();
      if (!cleanUrl || !supabaseAnonKey || !email) return null;

      const res = await fetch(`${cleanUrl}/rest/v1/leads?email=eq.${encodeURIComponent(email)}&select=id&order=created_at.desc&limit=1`, {
        headers: {
          'apikey': supabaseAnonKey,
          'Authorization': `Bearer ${supabaseAnonKey}`
        }
      });

      if (!res.ok) return null;
      const data = await res.json();
      return data?.[0]?.id || null;
    }

    async function ensureLeadId() {
      const lead = getSavedLead();
      if (!lead) return null;
      if (lead.leadId) return lead.leadId;

      const leadId = await findLeadIdByEmail(lead.email);
      if (leadId) {
        localStorage.setItem('lead_cadastrado', JSON.stringify({ ...lead, leadId }));
      }

      return leadId;
    }

    async function recordEngagementEvent(eventType, points, eventKey, metadata = {}) {
      const cleanUrl = getCleanSupabaseUrl();
      if (!cleanUrl || !supabaseAnonKey || !eventType || !eventKey) return;

      try {
        const leadId = metadata.leadId || await ensureLeadId();
        if (!leadId) return;

        const res = await fetch(`${cleanUrl}/rest/v1/engagement_events`, {
          method: 'POST',
          headers: {
            'apikey': supabaseAnonKey,
            'Authorization': `Bearer ${supabaseAnonKey}`,
            'Content-Type': 'application/json',
            'Prefer': 'return=minimal'
          },
          body: JSON.stringify({
            lead_id: leadId,
            event_type: eventType,
            event_key: eventKey,
            points,
            metadata
          })
        });

        if (!res.ok && res.status !== 409) {
          console.warn('Evento de ranking nao registrado:', eventType, await res.text());
        }
      } catch (err) {
        console.warn('Erro ao registrar evento de ranking:', err);
      }
    }

    async function createSharedPrediction(leadId) {
      const cleanUrl = getCleanSupabaseUrl();
      if (!cleanUrl || !supabaseAnonKey) return null;

      for (let attempt = 0; attempt < 3; attempt++) {
        const slug = generatePredictionSlug();
        const res = await fetch(`${cleanUrl}/rest/v1/shared_predictions`, {
          method: 'POST',
          headers: {
            'apikey': supabaseAnonKey,
            'Authorization': `Bearer ${supabaseAnonKey}`,
            'Content-Type': 'application/json',
            'Prefer': 'return=representation'
          },
          body: JSON.stringify({
            slug,
            lead_id: leadId,
            simulation_data: getSimulationSnapshot()
          })
        });

        if (res.ok) {
          const data = await res.json();
          const savedSlug = data?.[0]?.slug || slug;
          return {
            slug: savedSlug,
            url: `${window.location.origin}/palpite/${savedSlug}`
          };
        }

        if (res.status !== 409) break;
      }

      return null;
    }

    async function ensurePublicPredictionUrl() {
      const lead = getSavedLead();
      if (lead?.predictionUrl) return lead.predictionUrl;
      if (!lead) return getLegacyShareUrl();

      let leadId = lead.leadId || null;
      if (!leadId) {
        leadId = await findLeadIdByEmail(lead.email);
      }

      const prediction = await createSharedPrediction(leadId);
      if (!prediction) return getLegacyShareUrl();

      const updatedLead = {
        ...lead,
        leadId,
        predictionSlug: prediction.slug,
        predictionUrl: prediction.url,
        url: prediction.url
      };
      localStorage.setItem('lead_cadastrado', JSON.stringify(updatedLead));

      return prediction.url;
    }

    async function executeAction(action) {
      let shareUrl = action === 'share' ? await ensurePublicPredictionUrl() : getShareUrl();
      shareUrl = appendRefCode(shareUrl);
      const text = `Acompanhe a Tabela da Copa 2026 em tempo real e participe do Bolão dos amigos! Participe: ${shareUrl}`;

      if (action === 'share') {
        const lead = getSavedLead();
        if (lead?.leadId) {
          const shareKey = lead.predictionSlug || btoa(shareUrl).replace(/=+$/, '');
          recordEngagementEvent('simulation_shared', 20, `share:${lead.leadId}:${shareKey}`, {
            leadId: lead.leadId,
            shareUrl
          });
        }

        const waUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`;
        if (navigator.share) {
          navigator.share({
            title: 'Tabela Copa 2026',
            text: text,
            url: shareUrl,
          }).catch(() => {
            window.open(waUrl, '_blank');
          });
        } else {
          window.open(waUrl, '_blank');
        }
      }
    }

    function generateRefCode() {
      return 'COPUS-' + Math.random().toString(36).substring(2, 6).toUpperCase();
    }

    if (leadForm) {
      leadForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const nome = document.getElementById('lead-name').value;
        const email = document.getElementById('lead-email').value;
        let shareUrl = getLegacyShareUrl();
        const simulationSnapshot = getSimulationSnapshot();

        const savedLead = getSavedLead();
        const refCode = savedLead?.refCode || generateRefCode();

        const leadData = { nome, email, url: shareUrl, refCode };
        localStorage.setItem('lead_cadastrado', JSON.stringify(leadData));

        if (leadModal) leadModal.classList.remove('active');

        if (supabaseUrl && supabaseAnonKey) {
          try {
            const payload = {
              nome: nome,
              email: email,
              simulacao_data: simulationSnapshot,
              url_compartilhamento: shareUrl,
              ref_code: refCode
            };

            let cleanUrl = getCleanSupabaseUrl();

            const leadRes = await fetch(`${cleanUrl}/rest/v1/leads`, {
              method: 'POST',
              headers: {
                'apikey': supabaseAnonKey,
                'Authorization': `Bearer ${supabaseAnonKey}`,
                'Content-Type': 'application/json',
                'Prefer': 'return=representation'
              },
              body: JSON.stringify(payload)
            });

            if (leadRes.ok) {
              const savedLeads = await leadRes.json();
              const savedLeadId = savedLeads?.[0]?.id || null;
              if (savedLeadId) {
                const updatedLeadData = { ...leadData, leadId: savedLeadId };
                localStorage.setItem('lead_cadastrado', JSON.stringify(updatedLeadData));
                await recordEngagementEvent('simulation_created', 10, `simulation:${savedLeadId}`, {
                  leadId: savedLeadId
                });

                const refCodeConvite = localStorage.getItem('ref_code_convite');
                if (refCodeConvite) {
                  try {
                    const referrerRes = await fetch(`${cleanUrl}/rest/v1/leads?ref_code=eq.${encodeURIComponent(refCodeConvite)}&select=id&limit=1`, {
                      headers: { 'apikey': supabaseAnonKey, 'Authorization': `Bearer ${supabaseAnonKey}` }
                    });
                    if (referrerRes.ok) {
                      const referrerData = await referrerRes.json();
                      const referrerId = referrerData[0]?.id;
                      if (referrerId && referrerId !== savedLeadId) {
                        const refCreateRes = await fetch(`${cleanUrl}/rest/v1/referrals`, {
                          method: 'POST',
                          headers: {
                            'apikey': supabaseAnonKey,
                            'Authorization': `Bearer ${supabaseAnonKey}`,
                            'Content-Type': 'application/json',
                            'Prefer': 'return=minimal'
                          },
                          body: JSON.stringify({ referrer_id: referrerId, invited_id: savedLeadId })
                        });
                        if (refCreateRes.ok) {
                          await recordEngagementEvent('friend_invited', 15, `friend_invited:${referrerId}:${savedLeadId}`, {
                            leadId: referrerId,
                            invitedId: savedLeadId
                          });
                          await recordEngagementEvent('invited_by_friend', 15, `invited_by_friend:${savedLeadId}`, {
                            leadId: savedLeadId,
                            referrerId: referrerId
                          });
                          localStorage.removeItem('ref_code_convite');
                        }
                      }
                    }
                  } catch (err) {
                    console.error("Erro ao registrar indicacao no banco:", err);
                  }
                }
              }
            }
            console.log("Lead sincronizado com Supabase com sucesso.");
          } catch (err) {
            console.error("Erro ao sincronizar com Supabase:", err);
          }
        }

        if (pendingAction) {
          await executeAction(pendingAction);
          pendingAction = null;
        }
        
        alert('Cadastro concluído com sucesso!');
      });
    }

    if (closeLeadModal) closeLeadModal.addEventListener('click', () => leadModal && leadModal.classList.remove('active'));
    if (closeSquadModal) closeSquadModal.addEventListener('click', () => squadModal && squadModal.classList.remove('active'));

