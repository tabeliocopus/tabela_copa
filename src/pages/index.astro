    // Save state locally
    function saveLocalState() {
      localStorage.setItem('sim_matches', JSON.stringify(matches));
      localStorage.setItem('sim_bracket', JSON.stringify(bracket));
    }

    // Load state locally
    function loadLocalState() {
      const savedMatches = localStorage.getItem('sim_matches');
      const savedBracket = localStorage.getItem('sim_bracket');
      // sim_scorers local var removed

      let isValid = true;
      if (savedMatches) {
        try {
          const parsed = JSON.parse(savedMatches);
          const teamsExist = Array.isArray(parsed) && parsed.length === initialMatches.length && parsed.every(m => teams[m.homeId] && teams[m.awayId]);
          if (teamsExist) {
            matches = parsed.map((m, idx) => ({
              ...m,
              datetime: initialMatches[idx]?.datetime || m.datetime,
              stadium: initialMatches[idx]?.stadium || m.stadium,
              city: initialMatches[idx]?.city || m.city
            }));
          } else {
            isValid = false;
          }
        } catch (e) {
          isValid = false;
        }
      }

      if (isValid) {
        if (savedBracket) {
          try {
            const parsedBracket = JSON.parse(savedBracket);
            if (Array.isArray(parsedBracket) && parsedBracket.length === 31) {
              bracket = parsedBracket;
            }
          } catch (e) {}
        }
        // local scorers load removed
      } else {
        console.warn("Outdated simulation state detected. Resetting local storage for compatibility.");
        localStorage.removeItem('sim_matches');
        localStorage.removeItem('sim_bracket');
        // local scorers removeItem removed
      }
    }

