    // Render Golden Boot / Artilharia list
    function renderArtilharia() {
      const tbody = document.getElementById('artilharia-body');
      const noMsg = document.getElementById('no-scorers-msg');
      if (!tbody || !noMsg) return;

      tbody.innerHTML = '';
      const list = artilheirosReais.slice(0, 5); // Top 5 artilheiros

      if (list.length > 0) {
        noMsg.style.display = 'none';
        list.forEach((p, index) => {
          const medal = index === 0 ? '🥇' : index === 1 ? '🥈' : index === 2 ? '🥉' : '';
          const rank = index > 2 ? `<span style="font-size: 0.8rem; opacity: 0.6; margin-right: 0.5rem;">${index + 1}º</span>` : '';
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td class="align-left">${medal}${rank} ${p.name}</td>
            <td class="align-left">
              <img src="${getFlagUrl(p.teamCode)}" class="flag-emoji" /> ${p.teamName}
            </td>
            <td><strong style="color: var(--color-primary); font-size: 1.1rem;">${p.goals}</strong></td>
