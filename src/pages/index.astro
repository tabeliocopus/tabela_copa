---
import Layout from '../layouts/Layout.astro';
import { teams, groups, generateMatches, validateWorldCupData } from '../data/worldCupData';

const initialMatches = generateMatches();
validateWorldCupData(); // Run build-time self-audit validation

// Supabase environment variables from server environment
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---

<Layout title="Tabela da Copa do Mundo FIFA 2026" description="Preencha sua Tabela da Copa do Mundo FIFA 2026, baixe para imprimir e guarde de recordação.">
  <main class="container">
    
    <!-- HEADER -->
    <header>
      <img src="/logo-copa.png" alt="FIFA World Cup 2026 Logo" class="official-logo" style="width: 140px; height: auto; margin: 0 auto 1.5rem auto; display: block;" />
      <div class="logo-badge">United States • Canada • Mexico 2026</div>
      <h1>TABELA DA COPA DO MUNDO 2026</h1>
      <p class="subtitle">Preencha os resultados dos jogos e monte a sua Tabela da Copa para baixar, imprimir e guardar de recordação!</p>
      
      <!-- NAV TABS -->
      <div class="tabs-container">
        <button class="tab-btn active" data-tab="jogos-dia">
          📅 Jogos Hoje
        </button>
        <button class="tab-btn" data-tab="fase-grupos">
          📋 Tabela da Copa
        </button>
        <button class="tab-btn" data-tab="mata-mata">
          🏆 Mata-Mata
        </button>
        <button class="tab-btn" data-tab="artilharia">
          👟 Artilharia
        </button>
        <button class="tab-btn" data-tab="bolao">
          👥 Bolão & Ranking
        </button>
      </div>
    </header>

    <!-- HOW IT WORKS INSTRUCTIONS -->
    <div class="instructions-card glass-card expanded" id="instructions-container">
      <div class="instructions-header" id="toggle-instructions">
        <span>💡 Como funciona esta Tabela?</span>
        <span class="toggle-icon">▼</span>
      </div>
      <div class="instructions-content active" id="instructions-body">
        <div class="steps-grid">
          <div class="step-item">
            <div class="step-number">1</div>
            <p>
              <strong>Acompanhe os Jogos</strong>
              Na aba principal, veja os jogos programados para hoje e os placares oficiais de ontem!
            </p>
          </div>
          <div class="step-item">
            <div class="step-number">2</div>
            <p>
              <strong>Preencha sua Tabela</strong>
              Na aba <strong>Tabela da Copa</strong> e <strong>Mata-Mata</strong>, preencha os placares. Ao final, clique em "Baixar Imagem" para guardar de recordação!
            </p>
          </div>
          <div class="step-item">
            <div class="step-number">3</div>
            <p>
              <strong>Top 3 Artilheiros</strong>
              Acompanhe em tempo real os 3 maiores artilheiros oficiais da Copa do Mundo na aba <strong>Artilharia</strong>!
            </p>
          </div>
          <div class="step-item">
            <div class="step-number">4</div>
            <p>
              <strong>Bolão do Brasil</strong>
              Vá na aba <strong>Bolão & Ranking</strong> e cadastre-se para competir com seus amigos focando exclusivamente nos jogos da Seleção Brasileira!
            </p>
          </div>
        </div>
        
        <div class="auto-fill-box" style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <button class="btn" id="auto-fill-btn">⚡ Preenchimento Automático (Placares aleatórios)</button>
          <button class="btn" id="reset-sim-btn">🗑️ Limpar Tabela</button>
        </div>
      </div>
    </div>

    <!-- MONETIZATION BANNER (Removed) -->

    <!-- VIEW 0: JOGOS DO DIA -->
    <section id="jogos-dia" class="view-panel active">
      <div class="glass-card" style="margin-bottom: 2rem;">
        <h2 style="color: var(--color-primary); font-weight: 700; margin-bottom: 1rem;">📅 Jogos de Hoje</h2>
        <div class="matches-list" id="today-matches-container">
          <!-- Populated via JS -->
        </div>
      </div>
      
      <div class="glass-card">
        <h2 style="color: var(--text-muted); font-weight: 700; margin-bottom: 1rem;">⬅️ Placares de Ontem</h2>
        <div class="matches-list" id="yesterday-matches-container">
          <!-- Populated via JS -->
        </div>
      </div>
    </section>

    <!-- VIEW 1: FASE DE GRUPOS -->
    <section id="fase-grupos" class="view-panel">
      <div class="groups-grid">
        {groups.map(groupLetter => (
          <div class="glass-card group-card" data-group={groupLetter}>
            <div class="group-title">
              Grupo {groupLetter}
              <span class="text-xs text-muted">Copa 2026</span>
            </div>
            
            <!-- Standings Table -->
            <table class="standing-table">
              <thead>
                <tr>
                  <th class="align-left">Sel.</th>
                  <th>P</th>
                  <th>J</th>
                  <th>V</th>
                  <th>SG</th>
                </tr>
              </thead>
              <tbody class="group-standings-body" id={`standings-${groupLetter}`}>
                <!-- Populated via JS -->
              </tbody>
            </table>

            <!-- Group Matches -->
            <div class="matches-list" id={`matches-${groupLetter}`}>
              <!-- Populated via JS -->
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- VIEW 2: MATA-MATA -->
    <section id="mata-mata" class="view-panel">
      <div class="bracket-wrapper" id="bracket-container">
        
        <!-- Round of 32 -->
        <div class="bracket-round" id="round-32">
          <h3 class="text-center text-muted text-xs font-bold uppercase tracking-wider mb-2">Dezesseis-avos (32)</h3>
          <!-- Populated via JS -->
        </div>

        <!-- Round of 16 -->
        <div class="bracket-round" id="round-16">
          <h3 class="text-center text-muted text-xs font-bold uppercase tracking-wider mb-2">Oitavas de Final</h3>
          <!-- Populated via JS -->
        </div>

        <!-- Quarter Finals -->
        <div class="bracket-round" id="round-8">
          <h3 class="text-center text-muted text-xs font-bold uppercase tracking-wider mb-2">Quartas de Final</h3>
          <!-- Populated via JS -->
        </div>

        <!-- Semi Finals -->
        <div class="bracket-round" id="round-4">
          <h3 class="text-center text-muted text-xs font-bold uppercase tracking-wider mb-2">Semifinais</h3>
          <!-- Populated via JS -->
        </div>

        <!-- Final -->
        <div class="bracket-round" id="round-2">
          <h3 class="text-center text-muted text-xs font-bold uppercase tracking-wider mb-2">Grande Final</h3>
          <!-- Populated via JS -->
        </div>

      </div>

      <!-- Champion Display Banner -->
      <div class="champion-banner" id="champion-display">
        <h3 class="text-xs text-muted font-bold tracking-widest uppercase">👑 Campeão do Mundo 2026 👑</h3>
        <img src="" alt="Bandeira do Campeão" class="champion-flag" id="champion-flag-img" />
        <div class="champion-name" id="champion-team-name">Brasil</div>
        <p class="text-muted text-sm mt-2">Parabéns! Sua simulação da Copa do Mundo foi concluída com sucesso.</p>
      </div>
    </section>

    <!-- VIEW 3: ARTILHARIA -->
    <section id="artilharia" class="view-panel">
      <div class="glass-card" style="max-width: 600px; margin: 0 auto; padding: 2rem;">
        <h2 class="text-center mb-6" style="color: var(--color-primary); font-weight: 700;">👟 Chuteira de Ouro (Artilharia)</h2>
        <table class="standing-table" style="font-size: 1rem;">
          <thead>
            <tr>
              <th class="align-left">Jogador</th>
              <th class="align-left">Seleção</th>
              <th>Gols</th>
            </tr>
          </thead>
          <tbody id="artilharia-body">
            <!-- Populated via JS -->
          </tbody>
        </table>
        <div id="no-scorers-msg" class="text-center text-muted py-6">
          A lista oficial de artilheiros será atualizada automaticamente em tempo real assim que os primeiros gols da Copa forem marcados!
        </div>
      </div>
    </section>

    <!-- VIEW 4: BOLÃO -->
    <section id="bolao" class="view-panel">
      <div class="bolao-wrapper">

        <!-- Se não tiver cadastro ainda -->
        <div id="bolao-gate" class="bolao-gate glass-card">
          <div class="bolao-gate-icon">👥</div>
          <h2>Bolão com Amigos (Apenas Jogos do Brasil)</h2>
          <p class="text-muted">A tabela da Copa é apenas para sua diversão e recordação! Mas se você quiser competir, cadastre-se agora para criar grupos com amigos no nosso <strong>Bolão focado exclusivamente nos jogos da Seleção Brasileira!</strong></p>
          <button class="btn btn-primary" id="bolao-goto-register" style="max-width:340px; margin-top:1rem;">📝 Cadastrar-se no Bolão do Brasil</button>
        </div>

        <!-- Painel principal do bolão (visível após cadastro) -->
        <div id="bolao-panel" style="display:none;">

          <!-- Ações do grupo -->
          <div class="bolao-actions">
            <div class="glass-card bolao-action-card" id="card-criar">
              <div class="bolao-action-icon">✨</div>
              <h3>Criar Bolão do Brasil</h3>
              <p class="text-muted">Gere um código único e convide seus amigos para competir nos placares da Seleção Brasileira!</p>
              <div class="bolao-form-row">
                <input type="text" id="bolao-group-name" class="form-input" placeholder="Nome do grupo (ex: Família Silva)" maxlength="40" />
                <button class="btn btn-primary" id="bolao-create-btn" style="white-space:nowrap;">Criar Grupo</button>
              </div>
            </div>

            <div class="glass-card bolao-action-card" id="card-entrar">
              <div class="bolao-action-icon">🔑</div>
              <h3>Entrar em um Grupo</h3>
              <p class="text-muted">Tem um código de um amigo? Cole aqui e entre na disputa!</p>
              <div class="bolao-form-row">
                <input type="text" id="bolao-join-code" class="form-input" placeholder="Código (ex: COPA-5984)" maxlength="10" style="text-transform:uppercase;" />
                <button class="btn btn-primary" id="bolao-join-btn" style="white-space:nowrap;">Entrar</button>
              </div>
            </div>
          </div>

          <!-- Indicações Card -->
          <div class="glass-card bolao-action-card" id="card-indicacao" style="margin-top: 1.5rem; display: block; max-width: 100%;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
              <div class="bolao-action-icon">📢</div>
              <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: var(--text-main);">Programa de Indicações</h3>
            </div>
            <p class="text-muted" style="margin-bottom: 0.75rem; font-size: 0.9rem;">
              Convide seus amigos para o bolão! Cada amigo que se cadastrar pelo seu link garante **+15 pontos** para você e **+15 pontos** para ele no Ranking do Brasil!
            </p>
            <div class="bolao-form-row">
              <input type="text" id="ref-link-input" class="form-input" readonly value="" style="background: rgba(0,0,0,0.2);" />
              <button class="btn btn-primary" id="ref-copy-btn" style="white-space:nowrap;">📋 Copiar Link</button>
            </div>
            <p class="text-xs text-muted" style="margin-top: 0.5rem; font-weight: 600;">
              Seu Código de Indicação: <span id="ref-code-display" style="color:var(--color-primary); font-family: monospace; font-size: 0.95rem; letter-spacing: 0.05em;"></span>
            </p>
          </div>

          <!-- Card de Conquistas/Badges -->
          <div class="glass-card bolao-action-card" id="card-conquistas" style="margin-top: 1.5rem; display: block; max-width: 100%;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
              <div class="bolao-action-icon">🏅</div>
              <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: var(--text-main);">Minhas Conquistas</h3>
            </div>
            <p class="text-muted" style="margin-bottom: 1rem; font-size: 0.9rem;">
              Complete desafios para liberar insígnias exclusivas e subir no Ranking do Brasil!
            </p>
            <div class="badges-grid" id="user-badges-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 95px), 1fr)); gap: 0.75rem;">
              <!-- Badges loaded dynamically -->
            </div>
          </div>

          <!-- Meus grupos -->
          <div id="bolao-my-groups" class="bolao-my-groups">
            <h3 class="bolao-section-title">🏅 Meus Bolões do Brasil</h3>
            <div id="bolao-groups-list" class="bolao-groups-list">
              <p class="text-muted text-center" style="padding:2rem;">Você ainda não participa de nenhum grupo.<br/>Crie ou entre em um acima!</p>
            </div>
          </div>

          <!-- Leaderboard do grupo selecionado -->
          <div id="bolao-leaderboard-section" style="display:none;">
            <div class="bolao-leaderboard-header">
              <button id="bolao-back-btn" class="bolao-back-btn">← Voltar</button>
              <h3 id="bolao-leaderboard-title">Ranking do Grupo</h3>
              <div class="bolao-code-badge" id="bolao-leaderboard-code"></div>
            </div>
            <div class="glass-card bolao-leaderboard">
              <table class="standing-table" style="font-size:1rem;">
                <thead>
                  <tr>
                    <th style="text-align:center; width:40px;">#</th>
                    <th class="align-left">Participante</th>
                    <th>Ver Palpites</th>
                    <th style="color: var(--color-accent);">Pontos (Em breve)</th>
                  </tr>
                </thead>
                <tbody id="bolao-leaderboard-body">
                  <!-- Populated via JS -->
                </tbody>
              </table>
            </div>
            <div class="bolao-share-row">
              <button class="btn" id="bolao-copy-link-btn" style="max-width:360px; background: rgba(0,255,135,0.15); border: 1px solid var(--border-glass-active); color: var(--color-primary);">📋 Copiar Link de Convite</button>
            </div>
          </div>

          <!-- Card Ranking Global -->
          <div class="glass-card bolao-action-card" style="margin-top: 1.5rem; max-width: 100%; background: linear-gradient(135deg, rgba(255,215,0,0.05), rgba(0,255,135,0.03)); border-color: rgba(255,215,0,0.2);">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
              <div class="bolao-action-icon">🌍</div>
              <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700;">Ranking Geral (Apenas Brasil)</h3>
            </div>
            <p class="text-muted" style="font-size: 0.9rem; margin-bottom: 1rem;">
              Veja o Ranking Global com <strong>todos</strong> os palpiteiros do site, focado unicamente nos jogos da Seleção Brasileira! Os pontos são atualizados conforme os resultados oficiais do Brasil saem.
            </p>
            <a href="/bolao/ranking-global" class="btn btn-primary" style="display: inline-block; width: auto; font-size: 0.9rem; text-decoration: none;">🏆 Ver Ranking do Brasil →</a>
          </div>

        </div>
      </div>
    </section>

    <!-- ACTION FLOATING BAR -->
    <div class="action-bar">
      <button class="action-btn" id="share-btn">
        <span>📢 Compartilhar</span>
      </button>
      <button class="action-btn secondary-action" id="download-btn">
        <span>🖼️ Baixar Imagem</span>
      </button>
      <button class="action-btn secondary-action" id="reset-btn">
        <span>🔄 Reiniciar</span>
      </button>
    </div>

    <!-- MODAL 1: LEAD CAPTURE (CADASTRO) -->
    <div class="modal-overlay" id="lead-modal">
      <div class="glass-card modal-content">
        <button class="close-modal-btn" id="close-lead-modal">&times;</button>
        <h2 style="font-weight: 800; margin-bottom: 0.5rem; text-align: center; color: var(--color-primary);">CADASTRE-SE</h2>
        <p class="text-muted text-center text-sm" style="margin-bottom: 1.5rem;">Cadastre-se rapidamente para participar do ranking global, criar bolões com amigos e salvar seus palpites!</p>
        
        <form id="lead-form">
          <div class="form-group">
            <label class="form-label" for="lead-name">Nome Completo</label>
            <input type="text" id="lead-name" class="form-input" placeholder="Seu nome" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="lead-email">E-mail</label>
            <input type="email" id="lead-email" class="form-input" placeholder="seu@email.com" required />
          </div>
          <button type="submit" class="btn btn-primary mt-2">Salvar & Gerar Link ➜</button>
        </form>
      </div>
    </div>

    <!-- MODAL 2: REMOVED (ARTILHARIA IS NOW OFFICIAL ONLY) -->

    <!-- MODAL 3: SQUAD DETAILS (ELENCO DETAILS) -->
    <div class="modal-overlay" id="squad-modal">
      <div class="glass-card modal-content" style="max-width: 450px;">
        <button class="close-modal-btn" id="close-squad-modal">&times;</button>
        <h3 style="font-weight: 800; margin-bottom: 1rem; text-align: center; color: var(--color-primary);" id="squad-modal-title">Elenco</h3>
        
        <div class="squad-modal-grid" id="squad-players-list">
          <!-- Populated via JS -->
        </div>
      </div>
    </div>

    <!-- MODAL 4: WELCOME MANUAL (CAROUSEL) -->
    <div class="modal-overlay" id="welcome-modal">
      <div class="glass-card modal-content" style="max-width: 450px; padding: 0; overflow: hidden; display: flex; flex-direction: column;">
        
        <div class="carousel-container" id="welcome-carousel">
          <!-- Slide 1 -->
          <div class="carousel-slide active" style="padding: 2.5rem 1.5rem; text-align: center;">
            <div style="font-size: 4rem; margin-bottom: 1rem; animation: float 3s ease-in-out infinite;">🎮</div>
            <h2 style="color: var(--color-primary); margin-bottom: 1rem; font-weight: 800; font-size: 1.5rem;">Preencha a Tabela</h2>
            <p class="text-muted" style="line-height: 1.6;">Preencha os placares dos jogos. A fase de mata-mata se desenha automaticamente até a grande final com base nos seus resultados!</p>
          </div>
          <!-- Slide 2 -->
          <div class="carousel-slide" style="padding: 2.5rem 1.5rem; text-align: center; display: none;">
            <div style="font-size: 4rem; margin-bottom: 1rem; animation: float 3s ease-in-out infinite;">🏆</div>
            <h2 style="color: var(--color-secondary); margin-bottom: 1rem; font-weight: 800; font-size: 1.5rem;">Bolão com Amigos</h2>
            <p class="text-muted" style="line-height: 1.6;">Crie grupos privados com amigos e dispute o ranking focado exclusivamente nos jogos da Seleção Brasileira!</p>
          </div>
          <!-- Slide 3 -->
          <div class="carousel-slide" style="padding: 2.5rem 1.5rem; text-align: center; display: none;">
            <div style="font-size: 4rem; margin-bottom: 1rem; animation: float 3s ease-in-out infinite;">⚡</div>
            <h2 style="color: #00ff87; margin-bottom: 1rem; font-weight: 800; font-size: 1.5rem;">Placares Oficiais</h2>
            <p class="text-muted" style="line-height: 1.6;">Não se preocupe em atualizar! Nossos robôs travam os placares reais assim que o jogo oficial acaba.</p>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.2rem 2rem; background: rgba(0,0,0,0.3); border-top: 1px solid var(--border-glass);">
          <div class="carousel-dots" id="welcome-dots">
            <span class="dot active"></span><span class="dot"></span><span class="dot"></span>
          </div>
          <button class="btn btn-primary" id="welcome-next-btn" style="width: auto; padding: 0.5rem 1.5rem;">Próximo ➔</button>
        </div>
      </div>
    </div>

    <!-- FOOTER -->
    <footer>
      <p>&copy; 2026 Tabela da Copa do Mundo 2026. Desenvolvido por <a href="https://github.com" target="_blank">Lucro Ninja</a>.</p>
    </footer>
  </main>

  <!-- CLIENT-SIDE LOGIC -->
  <script is:inline define:vars={{ initialMatches, teams, groups, supabaseUrl, supabaseAnonKey }}>
    window.onerror = function(msg, url, line, col, error) {
      document.body.innerHTML = `<div style="color:red; padding:2rem; background:white; font-size:1.5rem; z-index:9999; position:absolute; top:0; left:0; width:100%;">
        <h3>JS Error:</h3>
        <p>${msg}</p>
        <p>Line: ${line}, Col: ${col}</p>
        <p>${error ? error.stack : ''}</p>
      </div>` + document.body.innerHTML;
    };
    window.onunhandledrejection = function(event) {
      document.body.innerHTML = `<div style="color:red; padding:2rem; background:white; font-size:1.5rem; z-index:9999; position:absolute; top:0; left:0; width:100%;">
        <h3>Unhandled Promise Rejection:</h3>
        <p>${event.reason}</p>
      </div>` + document.body.innerHTML;
    };

    // We pass JSON variables safely from Astro metadata to browser JS
    let matches = JSON.parse(JSON.stringify(initialMatches));
    let artilheirosReais = []; // Lista oficial atualizada em tempo real
    let bracket = Array(31).fill(null); // Bracket slots: R32 (0-15), R16 (16-23), QF (24-27), SF (28-29), Final (30)

    // Selectors
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.view-panel');
    const leadModal = document.getElementById('lead-modal');
    const closeLeadModal = document.getElementById('close-lead-modal');
    const leadForm = document.getElementById('lead-form');
    const shareBtn = document.getElementById('share-btn');
    const downloadBtn = document.getElementById('download-btn');
    const resetBtn = document.getElementById('reset-btn');
    
    // scorer modal logic removed
    
    const squadModal = document.getElementById('squad-modal');
    const closeSquadModal = document.getElementById('close-squad-modal');
    
    // Tab switching
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));
        
        tab.classList.add('active');
        const targetPanel = document.getElementById(tab.dataset.tab);
        if (targetPanel) targetPanel.classList.add('active');
      });
    });

    // Helper: Country Flags URL
    function getFlagUrl(code) {
      if (code === 'gb-eng') return 'https://flagcdn.com/w40/gb-eng.png';
      return `https://flagcdn.com/w40/${code.toLowerCase()}.png`;
    }

    // Helper: Generate Score Select Options (0 to 15)
    function generateScoreOptions(selectedVal) {
      let opts = `<option value="" ${selectedVal === null || selectedVal === '' ? 'selected' : ''}>-</option>`;
      for (let i = 0; i <= 15; i++) {
        opts += `<option value="${i}" ${selectedVal === i ? 'selected' : ''}>${i}</option>`;
      }
      return opts;
    }

    // Render logic for single match card HTML
    function getMatchCardHTML(match, isSimulationView = false, forceShowScore = false) {
      const homeTeam = teams[match.homeId];
      const awayTeam = teams[match.awayId];
      
      if (match.isFinished || !isSimulationView) {
        let feedbackHtml = '';
        if (match.isFinished && match.userHomeScore !== undefined && match.userHomeScore !== null && match.userAwayScore !== undefined && match.userAwayScore !== null) {
          const uHome = parseInt(match.userHomeScore);
          const uAway = parseInt(match.userAwayScore);
          const rHome = parseInt(match.homeScore);
          const rAway = parseInt(match.awayScore);
          
          if (uHome === rHome && uAway === rAway) {
            feedbackHtml = `<div style="font-size: 0.75rem; color: var(--bg-main); font-weight: bold; text-align: center; margin-top: 0.75rem; background: var(--color-primary); border-radius: 4px; padding: 4px;">✅ Na mosca! Você cravou ${uHome}x${uAway}</div>`;
          } else if (
            (uHome > uAway && rHome > rAway) ||
            (uHome < uAway && rHome < rAway) ||
            (uHome === uAway && rHome === rAway)
          ) {
            feedbackHtml = `<div style="font-size: 0.75rem; color: var(--bg-main); font-weight: bold; text-align: center; margin-top: 0.75rem; background: var(--color-accent); border-radius: 4px; padding: 4px;">👍 Quase! Acertou o vencedor (Seu palpite: ${uHome}x${uAway})</div>`;
          } else {
            feedbackHtml = `<div style="font-size: 0.75rem; color: white; font-weight: bold; text-align: center; margin-top: 0.75rem; background: var(--color-danger); border-radius: 4px; padding: 4px;">❌ Zebra! Seu palpite era ${uHome}x${uAway}</div>`;
          }
        }

        const showScore = match.isFinished || forceShowScore;
        const hScore = (showScore && match.homeScore !== null) ? match.homeScore : '-';
        const aScore = (showScore && match.awayScore !== null) ? match.awayScore : '-';

        return `
          <div class="match-datetime">📅 ${match.datetime || ''} ${match.isFinished ? '<span style="color: var(--color-primary); font-weight: bold; font-size: 0.75rem; margin-left: 0.5rem; border: 1px solid var(--color-primary); padding: 2px 6px; border-radius: 10px; background: rgba(0,255,135,0.1);">✅ Oficial</span>' : ''}</div>
          <div class="match-venue" style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.5rem; text-align: center;">🏟️ ${match.stadium || ''}, ${match.city || ''}</div>
          <div class="match-row">
            <div class="match-team home">
              <span class="team-name" data-team-id="${match.homeId}">${homeTeam.name}</span>
              <img src="${getFlagUrl(homeTeam.code)}" alt="${homeTeam.name}" class="flag-emoji" />
            </div>
            <div class="match-scores-inputs">
              <div style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); border-radius: 6px; padding: 0.4rem 0.8rem; font-weight: bold; color: white; min-width: 45px; text-align: center;">${hScore}</div>
              <span class="match-vs" style="margin: 0 0.5rem; color: var(--color-primary);">x</span>
              <div style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); border-radius: 6px; padding: 0.4rem 0.8rem; font-weight: bold; color: white; min-width: 45px; text-align: center;">${aScore}</div>
            </div>
            <div class="match-team away">
              <img src="${getFlagUrl(awayTeam.code)}" alt="${awayTeam.name}" class="flag-emoji" />
              <span class="team-name" data-team-id="${match.awayId}">${awayTeam.name}</span>
            </div>
          </div>
          ${feedbackHtml}
        `;
      } else {
        return `
          <div class="match-datetime">📅 ${match.datetime || ''}</div>
          <div class="match-venue" style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.5rem; text-align: center;">🏟️ ${match.stadium || ''}, ${match.city || ''}</div>
          <div class="match-row">
            <div class="match-team home">
              <span class="team-name" data-team-id="${match.homeId}">${homeTeam.name}</span>
              <img src="${getFlagUrl(homeTeam.code)}" alt="${homeTeam.name}" class="flag-emoji" />
            </div>
            <div class="match-scores-inputs">
              <select class="score-input" id="${match.id}-home" data-match-id="${match.id}" data-side="home">
                ${generateScoreOptions(match.homeScore)}
              </select>
              <span class="match-vs">x</span>
              <select class="score-input" id="${match.id}-away" data-match-id="${match.id}" data-side="away">
                ${generateScoreOptions(match.awayScore)}
              </select>
            </div>
            <div class="match-team away">
              <img src="${getFlagUrl(awayTeam.code)}" alt="${awayTeam.name}" class="flag-emoji" />
              <span class="team-name" data-team-id="${match.awayId}">${awayTeam.name}</span>
            </div>
          </div>
        `;
      }
    }

    // Render Jogos do Dia
    function renderJogosDoDia() {
      const todayContainer = document.getElementById('today-matches-container');
      const yesterdayContainer = document.getElementById('yesterday-matches-container');
      if (!todayContainer || !yesterdayContainer) return;

      const now = new Date();
      const todayStr = String(now.getDate()).padStart(2, '0') + '/' + String(now.getMonth() + 1).padStart(2, '0') + '/' + now.getFullYear();
      
      const yesterday = new Date(now);
      yesterday.setDate(yesterday.getDate() - 1);
      const yesterdayStr = String(yesterday.getDate()).padStart(2, '0') + '/' + String(yesterday.getMonth() + 1).padStart(2, '0') + '/' + yesterday.getFullYear();

      const todayMatches = matches.filter(m => m.datetime.startsWith(todayStr));
      const yesterdayMatches = matches.filter(m => m.datetime.startsWith(yesterdayStr));

      todayContainer.innerHTML = '';
      yesterdayContainer.innerHTML = '';

      if (todayMatches.length === 0) {
        todayContainer.innerHTML = '<p class="text-center text-muted" style="padding: 1rem;">Nenhum jogo programado para hoje.</p>';
      } else {
        todayMatches.forEach(match => {
          const card = document.createElement('div');
          card.className = 'match-card';
          card.innerHTML = getMatchCardHTML(match, false, false);
          todayContainer.appendChild(card);
        });
      }

      if (yesterdayMatches.length === 0) {
        yesterdayContainer.innerHTML = '<p class="text-center text-muted" style="padding: 1rem;">Nenhum jogo ocorreu ontem.</p>';
      } else {
        yesterdayMatches.forEach(match => {
          const card = document.createElement('div');
          card.className = 'match-card';
          card.innerHTML = getMatchCardHTML(match, false, true);
          yesterdayContainer.appendChild(card);
        });
      }
    }

    // Initialize/Render phase of the groups matches
    function initGroups() {
      groups.forEach(groupLetter => {
        // Render empty standings first
        updateGroupStandings(groupLetter);

        // Render matches
        const matchesContainer = document.getElementById(`matches-${groupLetter}`);
        matchesContainer.innerHTML = '';

        const groupMatches = matches.filter(m => m.group === groupLetter);
        groupMatches.forEach(match => {
          const matchCard = document.createElement('div');
          matchCard.className = 'match-card';
          matchCard.innerHTML = getMatchCardHTML(match, true);
          matchesContainer.appendChild(matchCard);
        });
      });

      // Render Jogos do Dia
      renderJogosDoDia();

      // Bind input events
      document.querySelectorAll('.score-input').forEach(input => {
        input.addEventListener('change', (e) => {
          const matchId = e.target.dataset.matchId;
          const side = e.target.dataset.side;
          const scoreVal = e.target.value === '' ? null : parseInt(e.target.value, 10);
          
          const match = matches.find(m => m.id === matchId);
          if (match) {
            match[`${side}Score`] = scoreVal;
            
            // Show/Hide goal scorer selector button based on score value
            const btn = document.querySelector(`.goal-scorer-btn[data-match-id="${matchId}"][data-side="${side}"]`);
            if (btn) {
              btn.style.display = scoreVal > 0 ? 'inline' : 'none';
            }

            // Recalculate group table & update bracket
            updateGroupStandings(match.group);
            calculateQualifiedTeams();
            saveLocalState();
            renderJogosDoDia(); // Update today view as well
          }
        });
      });

      // Bind Team Name clicks to show squad modal
      document.querySelectorAll('.team-name').forEach(el => {
        el.addEventListener('click', () => {
          showSquadModal(el.dataset.teamId);
        });
      });

      // Bind Goal Scorer buttons
      document.querySelectorAll('.goal-scorer-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          openScorerModal(btn.dataset.matchId, btn.dataset.side);
        });
      });
    }

    // Recalculate Group Standings
    function updateGroupStandings(groupLetter) {
      const groupTeams = Object.keys(teams)
        .filter(key => teams[key].group === groupLetter)
        .map(key => ({
          id: key,
          name: teams[key].name,
          code: teams[key].code,
          p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, gd: 0, pts: 0, games: 0
        }));

      const groupMatches = matches.filter(m => m.group === groupLetter);

      groupMatches.forEach(m => {
        if (m.homeScore !== null && m.awayScore !== null) {
          const home = groupTeams.find(t => t.id === m.homeId);
          const away = groupTeams.find(t => t.id === m.awayId);

          home.games += 1;
          away.games += 1;
          home.gf += m.homeScore;
          home.ga += m.awayScore;
          away.gf += m.awayScore;
          away.ga += m.homeScore;
          
          home.gd = home.gf - home.ga;
          away.gd = away.gf - away.ga;

          if (m.homeScore > m.awayScore) {
            home.pts += 3;
            home.w += 1;
            away.l += 1;
          } else if (m.homeScore < m.awayScore) {
            away.pts += 3;
            away.w += 1;
            home.l += 1;
          } else {
            home.pts += 1;
            away.pts += 1;
            home.d += 1;
            away.d += 1;
          }
        }
      });

      // Sort standing rules: Points -> GD -> GF -> Alphabetical
      groupTeams.sort((a, b) => {
        if (b.pts !== a.pts) return b.pts - a.pts;
        if (b.gd !== a.gd) return b.gd - a.gd;
        if (b.gf !== a.gf) return b.gf - a.gf;
        return a.name.localeCompare(b.name);
      });

      // Render standings HTML
      const tableBody = document.getElementById(`standings-${groupLetter}`);
      if (tableBody) {
        tableBody.innerHTML = '';
        groupTeams.forEach((team, idx) => {
          let qualifyClass = '';
          if (idx < 2) qualifyClass = 'qualify-direct'; // Top 2 qualify
          
          const tr = document.createElement('tr');
          tr.className = qualifyClass;
          tr.innerHTML = `
            <td class="align-left">
              <span class="text-xs text-muted font-bold mr-1">${idx + 1}</span>
              <img src="${getFlagUrl(team.code)}" alt="" class="flag-emoji" />
              <span class="team-name" data-team-id="${team.id}">${team.name}</span>
            </td>
            <td><strong>${team.pts}</strong></td>
            <td>${team.games}</td>
            <td>${team.w}</td>
            <td>${team.gd}</td>
          `;
          tableBody.appendChild(tr);
        });
      }
    }

    // Calculate qualified teams from Group Stage
    function calculateQualifiedTeams() {
      // 1. Gather all group placements
      const groupWinners = []; // 1st places (12 teams)
      const groupRunnersUp = []; // 2nd places (12 teams)
      const groupThirds = []; // 3rd places (12 teams)

      groups.forEach(groupLetter => {
        const groupTeams = Object.keys(teams)
          .filter(key => teams[key].group === groupLetter)
          .map(key => ({
            id: key,
            name: teams[key].name,
            code: teams[key].code,
            pts: 0, gd: 0, gf: 0, w: 0
          }));

        const groupMatches = matches.filter(m => m.group === groupLetter);
        groupMatches.forEach(m => {
          if (m.homeScore !== null && m.awayScore !== null) {
            const home = groupTeams.find(t => t.id === m.homeId);
            const away = groupTeams.find(t => t.id === m.awayId);
            
            home.gf += m.homeScore;
            home.ga = (home.ga || 0) + m.awayScore;
            away.gf += m.awayScore;
            away.ga = (away.ga || 0) + m.homeScore;

            if (m.homeScore > m.awayScore) { home.pts += 3; home.w += 1; }
            else if (m.homeScore < m.awayScore) { away.pts += 3; away.w += 1; }
            else { home.pts += 1; away.pts += 1; }
          }
        });

        groupTeams.forEach(t => t.gd = t.gf - (t.ga || 0));

        groupTeams.sort((a, b) => {
          if (b.pts !== a.pts) return b.pts - a.pts;
          if (b.gd !== a.gd) return b.gd - a.gd;
          if (b.gf !== a.gf) return b.gf - a.gf;
          return a.name.localeCompare(b.name);
        });

        groupWinners.push(groupTeams[0]);
        groupRunnersUp.push(groupTeams[1]);
        groupThirds.push(groupTeams[2]);
      });

      // 2. Select 8 best third-placed teams
      groupThirds.sort((a, b) => {
        if (b.pts !== a.pts) return b.pts - a.pts;
        if (b.gd !== a.gd) return b.gd - a.gd;
        if (b.gf !== a.gf) return b.gf - a.gf;
        return a.name.localeCompare(b.name);
      });

      const bestThirds = groupThirds.slice(0, 8);

      // Pairings list for the Round of 32 (16 matches):
      // Winners: 1A-1L (12 teams)
      // Runners-up: 2A-2L (12 teams)
      // Best Thirds: T1-T8 (8 teams)
      
      const pairings = [
        // 1. Winner vs Best Third (8 matches)
        { home: groupWinners[0], away: bestThirds[0] }, // 1A vs T1
        { home: groupWinners[1], away: bestThirds[1] }, // 1B vs T2
        { home: groupWinners[2], away: bestThirds[2] }, // 1C vs T3
        { home: groupWinners[3], away: bestThirds[3] }, // 1D vs T4
        { home: groupWinners[4], away: bestThirds[4] }, // 1E vs T5
        { home: groupWinners[5], away: bestThirds[5] }, // 1F vs T6
        { home: groupWinners[6], away: bestThirds[6] }, // 1G vs T7
        { home: groupWinners[7], away: bestThirds[7] }, // 1H vs T8
        
        // 2. Winner vs Runner-up (4 matches)
        { home: groupWinners[8], away: groupRunnersUp[0] }, // 1I vs 2A
        { home: groupWinners[9], away: groupRunnersUp[1] }, // 1J vs 2B
        { home: groupWinners[10], away: groupRunnersUp[2] }, // 1K vs 2C
        { home: groupWinners[11], away: groupRunnersUp[3] }, // 1L vs 2D
        
        // 3. Runner-up vs Runner-up (4 matches)
        { home: groupRunnersUp[4], away: groupRunnersUp[5] }, // 2E vs 2F
        { home: groupRunnersUp[6], away: groupRunnersUp[7] }, // 2G vs 2H
        { home: groupRunnersUp[8], away: groupRunnersUp[9] }, // 2I vs 2J
        { home: groupRunnersUp[10], away: groupRunnersUp[11] } // 2K vs 2L
      ];

      // Update bracket inputs for Round of 32 (indices 0 to 15)
      for (let i = 0; i < 16; i++) {
        const pair = pairings[i];
        if (!bracket[i]) {
          bracket[i] = { homeId: null, awayId: null, homeScore: null, awayScore: null };
        }
        bracket[i].homeId = pair.home ? pair.home.id : null;
        bracket[i].awayId = pair.away ? pair.away.id : null;
      }

      // Propagate bracket winner updates
      updateBracketFlow();
      renderBracket();
    }

    // Propagate winners from R32 -> R16 -> QF -> SF -> Final
    function updateBracketFlow() {
      // Indices:
      // R32: 0-15
      // R16: 16-23 (derived from R32)
      // QF: 24-27 (derived from R16)
      // SF: 28-29 (derived from QF)
      // Final: 30 (derived from SF)

      // R16 Propagation (indices 16 to 23)
      for (let i = 0; i < 8; i++) {
        const matchLeft = bracket[i * 2];
        const matchRight = bracket[i * 2 + 1];
        
        if (!bracket[16 + i]) {
          bracket[16 + i] = { homeId: null, awayId: null, homeScore: null, awayScore: null };
        }
        
        bracket[16 + i].homeId = getMatchWinner(matchLeft);
        bracket[16 + i].awayId = getMatchWinner(matchRight);
      }

      // QF Propagation (indices 24 to 27)
      for (let i = 0; i < 4; i++) {
        const matchLeft = bracket[16 + i * 2];
        const matchRight = bracket[16 + i * 2 + 1];
        
        if (!bracket[24 + i]) {
          bracket[24 + i] = { homeId: null, awayId: null, homeScore: null, awayScore: null };
        }
        
        bracket[24 + i].homeId = getMatchWinner(matchLeft);
        bracket[24 + i].awayId = getMatchWinner(matchRight);
      }

      // SF Propagation (indices 28 to 29)
      for (let i = 0; i < 2; i++) {
        const matchLeft = bracket[24 + i * 2];
        const matchRight = bracket[24 + i * 2 + 1];
        
        if (!bracket[28 + i]) {
          bracket[28 + i] = { homeId: null, awayId: null, homeScore: null, awayScore: null };
        }
        
        bracket[28 + i].homeId = getMatchWinner(matchLeft);
        bracket[28 + i].awayId = getMatchWinner(matchRight);
      }

      // Final Propagation (index 30)
      const sfLeft = bracket[28];
      const sfRight = bracket[29];
      if (!bracket[30]) {
        bracket[30] = { homeId: null, awayId: null, homeScore: null, awayScore: null };
      }
      bracket[30].homeId = getMatchWinner(sfLeft);
      bracket[30].awayId = getMatchWinner(sfRight);

      // Determine Champion
      const champId = getMatchWinner(bracket[30]);
      const champDisplay = document.getElementById('champion-display');
      
      if (champId) {
        document.getElementById('champion-flag-img').src = getFlagUrl(teams[champId].code);
        document.getElementById('champion-team-name').textContent = teams[champId].name;
        champDisplay.style.display = 'flex';

        // Trigger lead modal automatically after a tiny delay
        setTimeout(() => {
          triggerLeadCaptureModal('champion_selected');
        }, 1000);
      } else {
        champDisplay.style.display = 'none';
      }
    }

    function getMatchWinner(match) {
      if (!match || match.homeId === null || match.awayId === null) return null;
      if (match.homeScore === null || match.awayScore === null) return null;
      if (match.homeScore > match.awayScore) return match.homeId;
      if (match.homeScore < match.awayScore) return match.awayId;
      return match.homeId; // Tie default to home team
    }

    // Render Bracket Tree
    function renderBracket() {
      const rounds = [
        { id: 'round-32', start: 0, count: 16, title: 'Rodada de 32' },
        { id: 'round-16', start: 16, count: 8, title: 'Oitavas de Final' },
        { id: 'round-8', start: 24, count: 4, title: 'Quartas de Final' },
        { id: 'round-4', start: 28, count: 2, title: 'Semifinais' },
        { id: 'round-2', start: 30, count: 1, title: 'Final' }
      ];

      rounds.forEach(r => {
        const container = document.getElementById(r.id);
        // Clear all except title
        const titleHtml = container.querySelector('h3').outerHTML;
        
        container.innerHTML = titleHtml + '<div class="bracket-matches"></div>';
        const matchesContainer = container.querySelector('.bracket-matches');

        for (let i = 0; i < r.count; i++) {
          const bracketIdx = r.start + i;
          const match = bracket[bracketIdx];
          
          const homeTeam = match.homeId ? teams[match.homeId] : { name: 'A definir', code: 'placeholder' };
          const awayTeam = match.awayId ? teams[match.awayId] : { name: 'A definir', code: 'placeholder' };

          const isHomeWinner = match.homeScore !== null && match.awayScore !== null && match.homeScore >= match.awayScore;
          const isAwayWinner = match.homeScore !== null && match.awayScore !== null && match.awayScore > match.homeScore;

          const matchDiv = document.createElement('div');
          matchDiv.className = 'glass-card bracket-match';
          matchDiv.innerHTML = `
            <div class="bracket-match-title">${r.title} - Jogo ${i + 1}</div>
            <div class="bracket-team-row ${isHomeWinner ? 'winner' : ''}">
              <div class="bracket-team-info">
                ${match.homeId ? `<img src="${getFlagUrl(homeTeam.code)}" class="flag-emoji" />` : ''}
                <span>${homeTeam.name}</span>
              </div>
              <select class="score-input bracket-score" 
                data-idx="${bracketIdx}" data-side="home" 
                ${!match.homeId || !match.awayId ? 'disabled' : ''}>
                ${generateScoreOptions(match.homeScore)}
              </select>
            </div>
            <div class="bracket-team-row ${isAwayWinner ? 'winner' : ''}">
              <div class="bracket-team-info">
                ${match.awayId ? `<img src="${getFlagUrl(awayTeam.code)}" class="flag-emoji" />` : ''}
                <span>${awayTeam.name}</span>
              </div>
              <select class="score-input bracket-score" 
                data-idx="${bracketIdx}" data-side="away" 
                ${!match.homeId || !match.awayId ? 'disabled' : ''}>
                ${generateScoreOptions(match.awayScore)}
              </select>
            </div>
          `;
          matchesContainer.appendChild(matchDiv);
        }
      });

      // Bind bracket inputs
      document.querySelectorAll('.bracket-score').forEach(input => {
        input.addEventListener('change', (e) => {
          const idx = parseInt(e.target.dataset.idx, 10);
          const side = e.target.dataset.side;
          const scoreVal = e.target.value === '' ? null : parseInt(e.target.value, 10);

          if (bracket[idx]) {
            bracket[idx][`${side}Score`] = scoreVal;
            updateBracketFlow();
            renderBracket();
            saveLocalState();
          }
        });
      });
    }

