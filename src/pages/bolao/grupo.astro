---
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';

// Brazil's group C matches (IDs from worldCupData.js)
const brazilMatchIds = ['C_M1', 'C_M3', 'C_M5']; // Brasil vs Marrocos, Brasil vs Haiti, Escócia vs Brasil
---

<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bolão do Brasil | Simulador Copa 2026</title>
  <meta name="description" content="Veja o ranking do seu grupo de amigos no Bolão do Brasil da Copa do Mundo 2026." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/global.css" />
  <style>
    .page-header { text-align: center; padding: 2rem 0 1.5rem; }
    .back-link { color: var(--color-secondary); text-decoration: none; font-size: 0.9rem; font-weight: 600; display: inline-flex; align-items: center; gap: 0.4rem; margin-bottom: 1.5rem; }
    .back-link:hover { color: var(--color-primary); }
    .group-hero { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; padding: 2rem; margin-bottom: 1.5rem; background: linear-gradient(135deg, rgba(0,255,135,0.05), rgba(96,165,250,0.05)); border: 1px solid var(--border-glass-active); border-radius: 16px; }
    .group-hero h1 { font-size: 2rem; font-weight: 800; color: var(--color-primary); }
    .group-hero .invite-code { background: rgba(0,0,0,0.4); border: 1px dashed var(--color-primary); color: var(--color-primary); font-family: monospace; font-size: 1.1rem; padding: 0.5rem 1.2rem; border-radius: 8px; letter-spacing: 0.1em; }
    .invite-box { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; justify-content: center; margin-top: 0.5rem; }
    .invite-link-input { flex: 1; min-width: 260px; max-width: 380px; padding: 0.65rem 1rem; background: rgba(0,0,0,0.3); border: 1px solid var(--border-glass); border-radius: 8px; color: var(--text-main); font-family: var(--font-sans); font-size: 0.9rem; }

    /* Points Legend */
    .points-legend { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 2rem; }
    .legend-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--text-muted); }
    .legend-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }

    /* Ranking table */
    .ranking-card { padding: 0; overflow: hidden; }
    .ranking-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-glass); display: flex; align-items: center; gap: 0.75rem; }
    .ranking-header h2 { font-size: 1.2rem; font-weight: 700; color: var(--text-main); }
    .ranking-table { width: 100%; border-collapse: collapse; }
    .ranking-table th { padding: 0.75rem 1rem; text-align: left; font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border-glass); }
    .ranking-table th.center { text-align: center; }
    .ranking-table td { padding: 0.9rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.03); }
    .ranking-table td.center { text-align: center; }
    .rank-pos { font-weight: 800; font-size: 1rem; text-align: center; }
    .rank-pos.gold { color: #FFD700; }
    .rank-pos.silver { color: #C0C0C0; }
    .rank-pos.bronze { color: #CD7F32; }
    .rank-name { font-weight: 600; }
    .rank-pts { font-weight: 800; font-size: 1.1rem; color: var(--color-primary); text-align: center; }
    .rank-pts.zero { color: var(--text-muted); }
    .match-score-badge { display: inline-block; padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; margin: 0 0.15rem; }
    .badge-exact { background: rgba(0,255,135,0.2); color: var(--color-primary); }
    .badge-winner { background: rgba(96,165,250,0.2); color: var(--color-secondary); }
    .badge-miss { background: rgba(255,71,87,0.15); color: var(--color-danger); }
    .badge-pending { background: rgba(255,255,255,0.08); color: var(--text-muted); }

    /* Brazil matches section */
    .br-matches-section { margin-top: 2rem; }
    .br-matches-section h2 { font-size: 1.1rem; font-weight: 700; color: var(--color-secondary); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
    .br-match-card { padding: 1rem 1.25rem; margin-bottom: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .br-match-info { font-size: 0.75rem; color: var(--text-muted); }
    .br-match-teams { display: flex; align-items: center; justify-content: center; gap: 1rem; font-weight: 700; font-size: 1.05rem; }
    .br-match-score { background: rgba(0,0,0,0.4); padding: 0.25rem 0.75rem; border-radius: 6px; font-family: monospace; font-size: 1.1rem; color: var(--color-accent); border: 1px solid var(--border-glass); }
    .real-result-badge { background: rgba(0,255,135,0.1); border: 1px solid var(--color-primary); color: var(--color-primary); padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.7rem; font-weight: 700; text-align: center; }
    .pending-badge { background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); color: var(--text-muted); padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.7rem; text-align: center; }

    .empty-state { text-align: center; padding: 3rem; color: var(--text-muted); }
    .loading-state { text-align: center; padding: 2rem; color: var(--text-muted); }

    @media (max-width: 640px) {
      .ranking-table th:nth-child(4), .ranking-table td:nth-child(4) { display: none; }
      .invite-code { font-size: 0.9rem; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="page-header">
      <a href="/" class="back-link">← Voltar para o Simulador</a>
    </div>

    <!-- Group Hero -->
    <div class="group-hero" id="group-hero">
      <div style="font-size: 3rem;">🇧🇷</div>
      <h1 id="group-name-display">Carregando grupo...</h1>
      <div class="invite-code" id="group-code-display">---</div>
      <p style="color: var(--text-muted); font-size: 0.85rem; text-align: center;">Compartilhe o código ou o link abaixo para convidar seus amigos!</p>
      <div class="invite-box">
        <input class="invite-link-input" id="invite-link-input" type="text" readonly value="" />
        <button class="btn btn-primary" id="copy-invite-btn" style="width: auto; font-size: 0.9rem;">📋 Copiar Link</button>
      </div>
    </div>

    <!-- Scoring Legend -->
    <div class="points-legend">
      <div class="legend-item"><div class="legend-dot" style="background: var(--color-primary)"></div> Placar exato = <strong style="color:var(--color-primary)">5 pts</strong></div>
      <div class="legend-item"><div class="legend-dot" style="background: var(--color-secondary)"></div> Acertou o vencedor = <strong style="color:var(--color-secondary)">2 pts</strong></div>
      <div class="legend-item"><div class="legend-dot" style="background: var(--color-danger)"></div> Errou tudo = <strong style="color:var(--color-danger)">0 pts</strong></div>
    </div>

    <!-- Ranking Table -->
    <div class="glass-card ranking-card" id="ranking-card">
      <div class="ranking-header">
        <span style="font-size: 1.5rem;">🏆</span>
        <h2>Ranking do Grupo (Jogos do Brasil)</h2>
      </div>
      <div id="ranking-content">
        <div class="loading-state">Carregando ranking...</div>
      </div>
    </div>

    <!-- Brazil Matches Results Section -->
    <div class="br-matches-section">
      <h2>🇧🇷 Jogos do Brasil — Resultados Oficiais</h2>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">Os resultados reais serão inseridos à medida que os jogos acontecerem. Os pontos são recalculados automaticamente!</p>
      <div id="brazil-matches-list">
        <div class="loading-state">Carregando jogos...</div>
      </div>
    </div>

  </div>

  <script is:inline define:vars={{ supabaseUrl, supabaseAnonKey, brazilMatchIds }}>
    const getBaseUrl = () => (supabaseUrl || '').trim().replace(/\/rest\/v1\/?$/, '').replace(/\/$/, '');

    async function req(endpoint, method = 'GET', body = null) {
      const url = getBaseUrl();
      if (!url || !supabaseAnonKey) return null;
      const opts = {
        method,
        headers: {
          'Content-Type': 'application/json',
          'apikey': supabaseAnonKey,
          'Authorization': `Bearer ${supabaseAnonKey}`,
          'Prefer': 'return=representation'
        }
      };
      if (body) opts.body = JSON.stringify(body);
      try {
        const r = await fetch(`${url}/rest/v1/${endpoint}`, opts);
        if (!r.ok) return null;
        return r.json();
      } catch(e) { return null; }
    }

    function getLocalLeadInfo() {
      try { return JSON.parse(localStorage.getItem('sim_lead_info') || 'null'); } catch(e) { return null; }
    }

    function getLocalMatches() {
      try { return JSON.parse(localStorage.getItem('sim_matches') || 'null'); } catch(e) { return null; }
    }

    // Scoring rules: Compare member palpite vs real result
    function calculatePoints(palpiteHome, palpiteAway, realHome, realAway) {
      if (realHome === null || realAway === null) return null; // game not played yet
      if (palpiteHome === null || palpiteAway === null) return 0;

      // Exact score
      if (palpiteHome === realHome && palpiteAway === realAway) return 5;

      // Correct winner/draw
      const palpiteResult = Math.sign(palpiteHome - palpiteAway);
      const realResult = Math.sign(realHome - realAway);
      if (palpiteResult === realResult) return 2;

      return 0;
    }

    // Brazil match metadata (from worldCupData.js Group C)
    const brazilMatches = [
      { id: 'C_M1', home: 'Brasil', away: 'Marrocos', datetime: '13/06/2026 (Sábado) – 19:00', homeId: 'BR', awayId: 'MA' },
      { id: 'C_M3', home: 'Brasil', away: 'Haiti',    datetime: '19/06/2026 (Sexta-feira) – 21:30', homeId: 'BR', awayId: 'HT' },
      { id: 'C_M5', home: 'Escócia', away: 'Brasil',  datetime: '24/06/2026 (Quarta-feira) – 19:00', homeId: 'GB-SCT', awayId: 'BR' }
    ];

    function getFlagUrl(code) {
      if (code === 'GB-SCT' || code === 'gb-sct') return 'https://flagcdn.com/w40/gb-sct.png';
      return `https://flagcdn.com/w40/${code.toLowerCase()}.png`;
    }

    function renderBrazilMatches(realResults) {
      const container = document.getElementById('brazil-matches-list');
      container.innerHTML = '';
      brazilMatches.forEach(m => {
        const real = realResults ? realResults[m.id] : null;
        const hasResult = real && real.homeScore !== null && real.awayScore !== null;
        const card = document.createElement('div');
        card.className = 'glass-card br-match-card';
        card.innerHTML = `
          <div class="br-match-info">📅 ${m.datetime}</div>
          <div class="br-match-teams">
            <span><img src="${getFlagUrl(m.homeId)}" style="width:24px;height:16px;object-fit:cover;border-radius:2px;vertical-align:middle;margin-right:6px;">${m.home}</span>
            ${hasResult
              ? `<div class="br-match-score">${real.homeScore} x ${real.awayScore}</div>`
              : `<div class="br-match-score" style="color:var(--text-muted);">? x ?</div>`
            }
            <span>${m.away}<img src="${getFlagUrl(m.awayId)}" style="width:24px;height:16px;object-fit:cover;border-radius:2px;vertical-align:middle;margin-left:6px;"></span>
          </div>
          ${hasResult
            ? `<div class="real-result-badge">✅ Resultado oficial registrado</div>`
            : `<div class="pending-badge">⏳ Aguardando o jogo acontecer</div>`
          }
        `;
        container.appendChild(card);
      });
    }

    async function loadRealResults() {
      // Table: resultados_reais - columns: match_id (text PK), home_score (int), away_score (int)
      const results = await req('resultados_reais?match_id=in.(' + brazilMatchIds.join(',') + ')');
      const map = {};
      if (results) {
        results.forEach(r => {
          map[r.match_id] = { homeScore: r.home_score, awayScore: r.away_score };
        });
      }
      return map;
    }

    async function loadMembersAndPalpites(groupId, realResults) {
      const container = document.getElementById('ranking-content');

      // Fetch members with lead info
      const members = await req(
        `grupo_membros?grupo_id=eq.${groupId}&select=lead_id,joined_at,leads(id,nome,url_compartilhamento,sim_data)&order=joined_at.asc`
      );

      if (!members || members.length === 0) {
        container.innerHTML = `<div class="empty-state"><p>Nenhum participante ainda.</p><p style="font-size:0.85rem;margin-top:0.5rem;">Compartilhe o código do grupo para chamar os amigos!</p></div>`;
        return;
      }

      // Calculate points per member
      const ranked = members.map(m => {
        const lead = m.leads || {};
        let totalPts = 0;
        let gamesPlayed = 0;
        const matchDetails = {};

        // Try to decode their sim_data (base64 string: "matchId-home-away_matchId-home-away")
        let palpites = {};
        if (lead.sim_data) {
          try {
            const decoded = atob(lead.sim_data);
            decoded.split('_').forEach(part => {
              if (!part) return;
              const [id, home, away] = part.split('-');
              palpites[id] = { home: parseInt(home, 10), away: parseInt(away, 10) };
            });
          } catch(e) {}
        }

        brazilMatchIds.forEach(mid => {
          const palpite = palpites[mid];
          const real = realResults[mid];
          const pts = calculatePoints(
            palpite ? palpite.home : null,
            palpite ? palpite.away : null,
            real ? real.homeScore : null,
            real ? real.awayScore : null
          );
          matchDetails[mid] = { palpite, real, pts };
          if (pts !== null) { totalPts += pts; gamesPlayed++; }
        });

        return { lead, totalPts, matchDetails, gamesPlayed };
      });

      // Sort by points descending
      ranked.sort((a, b) => b.totalPts - a.totalPts);

      // Render table
      const posIcons = ['🥇', '🥈', '🥉'];
      const tableHTML = `
        <table class="ranking-table">
          <thead>
            <tr>
              <th class="center">#</th>
              <th>Participante</th>
              ${brazilMatches.map(m => `<th class="center" title="${m.home} x ${m.away}">${m.home === 'Brasil' ? '🇧🇷' : '🏴󠁧󠁢󠁳󠁣󠁴󠁿'} x ${m.away === 'Brasil' ? '🇧🇷' : m.away.substring(0,3)}</th>`).join('')}
              <th class="center">Pontos</th>
            </tr>
          </thead>
          <tbody>
            ${ranked.map((r, i) => {
              const posClass = i === 0 ? 'gold' : i === 1 ? 'silver' : i === 2 ? 'bronze' : '';
              const pos = posIcons[i] || `${i+1}º`;
              return `<tr>
                <td class="rank-pos ${posClass}">${pos}</td>
                <td class="rank-name">
                  ${r.lead.nome || 'Anônimo'}
                  ${r.lead.url_compartilhamento ? `<br><a href="${r.lead.url_compartilhamento}" target="_blank" style="font-size:0.7rem;color:var(--color-secondary);">Ver simulação</a>` : ''}
                </td>
                ${brazilMatchIds.map(mid => {
                  const d = r.matchDetails[mid];
                  if (!d.real || d.real.homeScore === null) {
                    const p = d.palpite;
                    return `<td class="center"><span class="match-score-badge badge-pending">${p ? `${p.home}x${p.away}` : '?'}</span></td>`;
                  }
                  if (d.pts === 5) return `<td class="center"><span class="match-score-badge badge-exact">${d.palpite?.home}x${d.palpite?.away} ⭐</span></td>`;
                  if (d.pts === 2) return `<td class="center"><span class="match-score-badge badge-winner">${d.palpite?.home ?? '?'}x${d.palpite?.away ?? '?'} ✓</span></td>`;
                  return `<td class="center"><span class="match-score-badge badge-miss">${d.palpite ? `${d.palpite.home}x${d.palpite.away}` : '?'} ✗</span></td>`;
                }).join('')}
                <td class="rank-pts ${r.totalPts === 0 && r.gamesPlayed === 0 ? 'zero' : ''}">${r.totalPts}</td>
              </tr>`;
            }).join('')}
          </tbody>
        </table>
      `;
      container.innerHTML = tableHTML;
    }

    async function init() {
      const params = new URLSearchParams(window.location.search);
      const groupId = params.get('id');
      const groupCode = params.get('code');

      // Resolve group info
      let group = null;
      if (groupId) {
        const res = await req(`grupos?id=eq.${groupId}`);
        if (res && res[0]) group = res[0];
      } else if (groupCode) {
        const res = await req(`grupos?codigo_acesso=eq.${groupCode}`);
        if (res && res[0]) group = res[0];
      }

      if (!group) {
        document.getElementById('group-name-display').textContent = 'Grupo não encontrado';
        document.getElementById('ranking-content').innerHTML = `<div class="empty-state">Grupo não encontrado. <a href="/bolao" style="color:var(--color-primary)">Voltar aos meus bolões</a></div>`;
        return;
      }

      // Update UI with group info
      document.getElementById('group-name-display').textContent = group.nome;
      document.getElementById('group-code-display').textContent = group.codigo_acesso;

      const inviteLink = `${window.location.origin}/?bolao=${group.codigo_acesso}`;
      document.getElementById('invite-link-input').value = inviteLink;

      document.getElementById('copy-invite-btn').addEventListener('click', () => {
        navigator.clipboard.writeText(inviteLink).then(() => {
          document.getElementById('copy-invite-btn').textContent = '✅ Copiado!';
          setTimeout(() => { document.getElementById('copy-invite-btn').textContent = '📋 Copiar Link'; }, 2500);
        });
      });

      // Load real results & members in parallel
      const realResults = await loadRealResults();
      renderBrazilMatches(realResults);
      await loadMembersAndPalpites(group.id, realResults);
    }

    init();
  </script>
</body>
</html>
