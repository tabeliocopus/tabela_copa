---
// src/pages/bolao/index.astro
// Hub central para gerenciar Bolões (Privados e Global)
const title = "Meus Bolões | Simulador Copa 2026";
const description = "Crie grupos privados para competir com seus amigos ou participe do Palpitão Global da Copa do Mundo de 2026.";
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/global.css" />
    <style>
      .bolao-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-top: 2rem;
      }
      .card-bolao {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 2rem;
      }
      .card-bolao h2 {
        color: var(--color-primary);
        font-size: 1.8rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .card-bolao p {
        color: var(--text-muted);
        font-size: 1rem;
      }
      .actions {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
        flex-wrap: wrap;
      }
      .input-group {
        display: flex;
        gap: 0.5rem;
        flex: 1;
        min-width: 250px;
      }
      .input-group input {
        flex: 1;
        padding: 0.75rem 1rem;
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid var(--border-glass);
        border-radius: 8px;
        color: var(--text-main);
        font-family: var(--font-sans);
        font-size: 1rem;
      }
      .input-group input:focus {
        outline: none;
        border-color: var(--color-primary);
      }
      .divider {
        width: 100%;
        height: 1px;
        background: var(--border-glass);
        margin: 1rem 0;
      }
      #grupos-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1.5rem;
      }
      .grupo-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border-glass);
        border-radius: 8px;
        transition: var(--transition-smooth);
        cursor: pointer;
        text-decoration: none;
        color: var(--text-main);
      }
      .grupo-item:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: var(--color-primary);
        transform: translateY(-2px);
      }
      .grupo-item-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .grupo-item-title {
        font-weight: 700;
        font-size: 1.1rem;
      }
      .grupo-item-meta {
        font-size: 0.8rem;
        color: var(--text-muted);
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <a href="/" style="text-decoration: none;">
          <img src="/logo-copa.png" alt="FIFA World Cup 2026 Logo" class="official-logo" style="width: 100px; height: auto; margin: 0 auto 1.5rem auto; display: block;" />
        </a>
        <h1>MEUS BOLÕES 🏆</h1>
        <p class="subtitle">Crie grupos com amigos para competir ou participe do Ranking Global.</p>
        
        <div style="margin-top: 1.5rem;">
          <a href="/" class="btn btn-secondary" style="display: inline-block; width: auto; font-size: 0.9rem;">← Voltar para o Simulador</a>
        </div>
      </header>

      <div class="bolao-container">
        <!-- SEÇÃO: BOLÃO PRIVADO -->
        <div class="glass-card card-bolao">
          <h2>🔐 Bolão Privado (Amigos)</h2>
          <p>Crie um grupo fechado só para a sua galera. A competição inicial foca <strong>apenas nos Jogos do Brasil</strong> para facilitar a participação de todo mundo!</p>
          
          <div class="actions">
            <!-- Criar Grupo -->
            <div style="flex: 1; min-width: 250px; display: flex; flex-direction: column; gap: 0.5rem;">
              <label class="form-label">Criar Novo Grupo</label>
              <div class="input-group">
                <input type="text" id="novo-grupo-nome" placeholder="Ex: Galera da Firma" />
                <button class="btn btn-primary" id="btn-criar-grupo" style="width: auto;">Criar Grupo</button>
              </div>
            </div>

            <!-- Entrar em Grupo -->
            <div style="flex: 1; min-width: 250px; display: flex; flex-direction: column; gap: 0.5rem;">
              <label class="form-label">Entrar com Código</label>
              <div class="input-group">
                <input type="text" id="codigo-acesso" placeholder="Ex: BRASIL-X7P9" style="text-transform: uppercase;" />
                <button class="btn btn-secondary" id="btn-entrar-grupo" style="width: auto;">Entrar</button>
              </div>
            </div>
          </div>

          <div class="divider"></div>

          <h3>Seus Grupos Ativos:</h3>
          <div id="grupos-list">
            <p style="color: var(--text-muted); font-size: 0.9rem; font-style: italic;">Você ainda não está em nenhum grupo. Crie um ou use um código para entrar!</p>
          </div>
        </div>

        <!-- SEÇÃO: PALPITÃO GERAL -->
        <div class="glass-card card-bolao">
          <h2>🌍 Palpitão Geral da Copa</h2>
          <p>O Ranking Global reúne todos os simuladores salvos no site. Os pontos são calculados baseados em todos os 104 jogos reais da Copa do Mundo.</p>
          
          <div style="margin-top: 1rem; padding: 1.5rem; background: rgba(0, 255, 135, 0.05); border: 1px dashed var(--color-primary); border-radius: 8px; text-align: center;">
            <p style="margin-bottom: 1rem; font-weight: 600;">Seu status: <span id="status-global" style="color: var(--color-accent);">Aguardando submissão</span></p>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">Para participar do Ranking Global, você precisa preencher e salvar sua simulação completa na página principal.</p>
            <a href="/" class="btn btn-primary" style="display: inline-block; width: auto;">Ir para a Simulação Global</a>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
      const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';

      const getBaseUrl = () => (supabaseUrl || '').trim().replace(/\/rest\/v1\/?$/, '').replace(/\/$/, '');

      // Autenticação local (Lead ID)
      function getLocalLeadInfo() {
        try {
          const stored = localStorage.getItem('sim_lead_info');
          return stored ? JSON.parse(stored) : null;
        } catch(e) { return null; }
      }

      function promptLeadRegistration() {
        const email = prompt("Para criar ou entrar em grupos, precisamos do seu email:");
        if (!email) return null;
        const name = prompt("E como quer ser chamado no ranking? (Seu Nome / Apelido):") || 'Anônimo';
        // Aqui chamaria a função de registro de lead do backend se não estiver salvo
        return { email, name };
      }

      // Função utilitária para requests REST no Supabase
      async function supabaseRequest(endpoint, method = 'GET', body = null) {
        const cleanUrl = getBaseUrl();
        if (!cleanUrl || !supabaseAnonKey) return null;

        const options = {
          method,
          headers: {
            'Content-Type': 'application/json',
            'apikey': supabaseAnonKey,
            'Authorization': `Bearer ${supabaseAnonKey}`,
            'Prefer': 'return=representation'
          }
        };
        if (body) options.body = JSON.stringify(body);

        try {
          const res = await fetch(`${cleanUrl}/rest/v1/${endpoint}`, options);
          if (!res.ok) throw new Error(`Erro ${res.status}`);
          return await res.json();
        } catch(e) {
          console.error("Supabase Request Failed", e);
          return null;
        }
      }

      // DOM Elements
      const btnCriar = document.getElementById('btn-criar-grupo');
      const inputNome = document.getElementById('novo-grupo-nome');
      const btnEntrar = document.getElementById('btn-entrar-grupo');
      const inputCodigo = document.getElementById('codigo-acesso');
      const gruposList = document.getElementById('grupos-list');

      async function carregarGruposDoUsuario(leadId) {
        if (!leadId) return;
        
        // Pega as relações do membro
        const membrosRel = await supabaseRequest(`membros_grupo?lead_id=eq.${leadId}&select=grupo_id`);
        if (!membrosRel || membrosRel.length === 0) {
          gruposList.innerHTML = `<p style="color: var(--text-muted); font-size: 0.9rem; font-style: italic;">Você ainda não está em nenhum grupo. Crie um ou use um código para entrar!</p>`;
          return;
        }

        const grupoIds = membrosRel.map(m => m.grupo_id).join(',');
        // Busca os detalhes dos grupos
        const grupos = await supabaseRequest(`grupos?id=in.(${grupoIds})`);
        
        if (grupos && grupos.length > 0) {
          gruposList.innerHTML = '';
          grupos.forEach(g => {
            const el = document.createElement('a');
            el.className = 'grupo-item';
            el.href = `/bolao/grupo?id=${g.id}`;
            el.innerHTML = `
              <div class="grupo-item-info">
                <span class="grupo-item-title">${g.nome}</span>
                <span class="grupo-item-meta">Código de Convite: <strong style="color:var(--color-primary);">${g.codigo_acesso}</strong></span>
              </div>
              <div style="color: var(--color-secondary);">Entrar →</div>
            `;
            gruposList.appendChild(el);
          });
        }
      }

      // Fluxo: Criar Grupo
      btnCriar.addEventListener('click', async () => {
        const nome = inputNome.value.trim();
        if (!nome) return alert('Digite um nome para o grupo.');

        let leadInfo = getLocalLeadInfo();
        if (!leadInfo || !leadInfo.leadId) {
           alert("Você precisa salvar um palpite na página inicial com seu email para poder criar grupos.");
           return;
        }

        btnCriar.textContent = 'Criando...';
        btnCriar.disabled = true;

        const codigo = 'BR-' + Math.random().toString(36).substring(2, 8).toUpperCase();
        
        // Inserir grupo
        const grupoCriado = await supabaseRequest('grupos', 'POST', {
          nome: nome,
          codigo_acesso: codigo,
          criador_id: leadInfo.leadId
        });

        if (grupoCriado && grupoCriado[0]) {
          const groupId = grupoCriado[0].id;
          // Insere o criador como membro
          await supabaseRequest('membros_grupo', 'POST', {
            grupo_id: groupId,
            lead_id: leadInfo.leadId
          });
          
          alert(`Grupo criado com sucesso! Compartilhe o código: ${codigo}`);
          inputNome.value = '';
          carregarGruposDoUsuario(leadInfo.leadId);
        } else {
          alert("Erro ao criar o grupo. Verifique sua conexão e se as tabelas existem no Supabase.");
        }
        
        btnCriar.textContent = 'Criar Grupo';
        btnCriar.disabled = false;
      });

      // Fluxo: Entrar em Grupo
      btnEntrar.addEventListener('click', async () => {
        const cod = inputCodigo.value.trim().toUpperCase();
        if (!cod) return alert('Digite o código do grupo.');

        let leadInfo = getLocalLeadInfo();
        if (!leadInfo || !leadInfo.leadId) {
           alert("Você precisa salvar um palpite na página inicial com seu email para poder participar de grupos.");
           return;
        }

        btnEntrar.textContent = 'Buscando...';
        btnEntrar.disabled = true;

        const grupoResult = await supabaseRequest(`grupos?codigo_acesso=eq.${cod}`);
        
        if (grupoResult && grupoResult.length > 0) {
          const groupId = grupoResult[0].id;
          
          // Verifica se já é membro
          const checagem = await supabaseRequest(`membros_grupo?grupo_id=eq.${groupId}&lead_id=eq.${leadInfo.leadId}`);
          
          if (checagem && checagem.length > 0) {
            alert("Você já está neste grupo!");
          } else {
            // Insere membro
            const membroNovo = await supabaseRequest('membros_grupo', 'POST', {
              grupo_id: groupId,
              lead_id: leadInfo.leadId
            });
            if (membroNovo) {
              alert(`Bem-vindo ao grupo ${grupoResult[0].nome}!`);
              inputCodigo.value = '';
              carregarGruposDoUsuario(leadInfo.leadId);
            }
          }
        } else {
          alert('Código inválido ou grupo não encontrado.');
        }

        btnEntrar.textContent = 'Entrar';
        btnEntrar.disabled = false;
      });

      // Initial Load
      const info = getLocalLeadInfo();
      if (info && info.leadId) {
        carregarGruposDoUsuario(info.leadId);
      }
    </script>
  </body>
</html>
