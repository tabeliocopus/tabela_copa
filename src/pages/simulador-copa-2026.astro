---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Tabela da Copa do Mundo 2026",
  "description": "Tabela interativa da Copa do Mundo 2026. Acompanhe os resultados reais da fase de grupos ao mata-mata e participe do Bolão do Brasil!",
  "url": "https://tabelacopa.com/simulador-copa-2026",
  "applicationCategory": "SportsApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "BRL" }
};

const features = [
  { icon: '⚽', title: 'Fase de Grupos', desc: 'Acompanhe a classificação dos 12 grupos com 48 seleções e os resultados oficiais em tempo real.' },
  { icon: '🏆', title: 'Mata-Mata Oficial', desc: 'Chaveamento oficial atualizado automaticamente com base nos resultados reais até a grande final.' },
  { icon: '👟', title: 'Artilharia Oficial', desc: 'Acompanhe a corrida pela Chuteira de Ouro com a lista oficial de artilheiros da Copa.' },
  { icon: '👥', title: 'Bolão do Brasil', desc: 'Crie grupos com amigos, faça seus palpites para os jogos do Brasil e dispute a liderança.' },
  { icon: '📢', title: 'Compartilhamento', desc: 'Compartilhe o código ou o link do seu grupo do Bolão com amigos facilmente.' },
  { icon: '📊', title: 'Ranking Global', desc: 'Ganhe pontos por cadastros, compartilhamentos e indicações. Suba no ranking de engajamento!' }
];
---

<Layout
  title="Tabela Copa 2026 — Resultados e Classificação ao Vivo"
  description="Acompanhe a Tabela da Copa do Mundo 2026 em tempo real! Confira placares ao vivo, classificação dos grupos, chaveamento oficial e o Bolão do Brasil."
>
  <main class="container seo-group-page">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <header>
      <div class="logo-badge">Copa do Mundo 2026</div>
      <h1>TABELA DA COPA DO MUNDO 2026</h1>
      <p class="subtitle">Acompanhe resultados, classificação, chaveamento do mata-mata e o Bolão do Brasil em tempo real!</p>
    </header>

    <section class="glass-card seo-section">
      <h2>🎮 Como Funciona</h2>
      <div class="seo-features-grid">
        {features.map(f => (
          <div class="glass-card seo-feature-card">
            <div class="seo-feature-icon">{f.icon}</div>
            <h3>{f.title}</h3>
            <p class="text-muted">{f.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="glass-card seo-section seo-cta-section">
      <h2>🚀 Comece Agora!</h2>
      <p>Acesse o painel em tempo real, veja a classificação atualizada e cadastre-se para participar do Bolão do Brasil!</p>
      <a href="/" class="btn btn-primary seo-cta-btn">VER TABELA DA COPA →</a>
    </section>
  </main>

  <style>
    .seo-group-page { padding-bottom: 5rem; }
    .seo-section { padding: 1.5rem; margin-bottom: 1.5rem; }
    .seo-section h2 { color: var(--color-secondary); font-size: 1.2rem; font-weight: 800; margin-bottom: 1rem; }
    .seo-features-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
    .seo-feature-card { padding: 1.25rem; text-align: center; border: 1px solid rgba(255,255,255,0.06); }
    .seo-feature-icon { font-size: 2rem; margin-bottom: 0.5rem; }
    .seo-feature-card h3 { font-size: 1rem; margin-bottom: 0.4rem; }
    .seo-feature-card p { font-size: 0.85rem; line-height: 1.4; }
    .seo-cta-section { text-align: center; }
    .seo-cta-section p { max-width: 520px; margin: 0 auto 1.25rem; color: var(--text-muted); }
    .seo-cta-btn { max-width: 320px; text-decoration: none; display: inline-block; }
    @media (max-width: 640px) {
      .seo-features-grid { grid-template-columns: 1fr; }
      .seo-section { padding: 1.1rem; }
    }
  </style>
</Layout>
